    "merchantTeam.danger.removeBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their merchant access ends immediately. Existing business records and transactions are kept. This can't be undone; to restore access, invite them again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除后对方的商家权限立即失效。已经产生的经营记录与流水保留，不会被删掉；此操作不可撤销，要恢复只能重新邀请一次。"
          }
        }
      }
    },
