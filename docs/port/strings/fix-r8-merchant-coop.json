        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销后已经发出的邀请链接立即失效，已经发出去的邀请链接立刻打不开。此操作不可撤销；要重新邀请需要另发一条，凭证只显示一次。"
          }
