  "roamTools.clearCache.confirmMessage": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This clears the fog, footprints and roam history on this phone, plus the recovery record of a roam you haven't finished. Footprint links you've shared stop working too. Records already uploaded to Chengyin aren't affected."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "会清掉这台手机上的迷雾、足迹、漫游记录，以及还没结束那次漫游的找回记录；分享出去的足迹链接也会失效。已上传到城瘾的记录不受影响。"
        }
      }
    }
  },
