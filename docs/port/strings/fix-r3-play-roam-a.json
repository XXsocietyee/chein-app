        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到站后扫现场的码"
          }
        }
      }
    },
    "playMerchant.perk.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shop perk"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本店权益"
          }
        }
      }
    },
    "roam.passportSheet.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roam passport and tools"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "漫游护照与工具"
          }
        }
      }
    },
    "roam.poi.pending.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the current result, or verify again on site with the current task. The earlier record stays until the result is confirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可查询当前结果，或重新到现场按当前任务核验；旧记录保留到确认完成。"
          }
        }
      }
    },
    "roam.poi.pending.notShown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The place doesn't show as completed or awaiting redemption yet. That doesn't mean the last request wasn't applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前尚未显示完成或待核销，不能据此判断上次请求未执行。"
          }
        }
      }
    },
    "roam.poi.pending.query": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check current status"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查询当前状态"
          }
        }
      }
    },
    "roam.poi.pending.recoveredDone": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmed: completed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已确认当前已完成"
          }
        }
      }
    },
    "roam.poi.pending.recoveredRedeem": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmed: awaiting redemption"
          }
