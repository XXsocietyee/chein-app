        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已确认当前待核销"
          }
        }
      }
    },
    "roam.poi.pending.reverify": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify again on site"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新现场核验"
          }
        }
      }
    },
    "roam.poi.pending.reverifyReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the on-site check with the current task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按当前任务开始现场核验"
          }
        }
      }
    },
    "roam.poi.pending.startReverify": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start on-site check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始现场核验"
          }
        }
      }
    },
    "roam.poi.pending.storageMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local storage isn't working, so no check-in is sent. Check the current status once storage is back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地存储异常，暂不提交打卡。请恢复存储后查询当前状态。"
          }
        }
      }
    },
    "roam.poi.pending.storageTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-in record can't be read or saved right now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打卡记录暂时无法读取或保存"
          }
        }
      }
    },
    "roam.poi.pending.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check-in result pending"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打卡结果待确认"
          }
        }
      }
    },
    "roam.poi.pending.unresolved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result can't be confirmed yet. Please check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前结果还无法确认，请继续查询。"
          }
