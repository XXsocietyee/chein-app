// Temporary identifier only. Apple Team/Bundle ID require release-owner confirmation.
PRODUCT_BUNDLE_IDENTIFIER = invalid.example.questify.ios
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1,2
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 2
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Chein
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
CODE_SIGN_STYLE = Automatic
// No ATS relaxation, credentials, or service endpoints. Entitlements: Config/Questify.entitlements, or with
// QUESTIFY_ASSOCIATED_DOMAINS = YES Config/QuestifyAssociatedDomains.entitlements (the same plus applinks).

// Set only an approved public API base URL; never put secrets in build settings.
QUESTIFY_MARKET = CN
INFOPLIST_KEY_QuestifyMarket = $(QUESTIFY_MARKET)
QUESTIFY_API_BASE_URL =
INFOPLIST_KEY_QuestifyAPIBaseURL = $(QUESTIFY_API_BASE_URL)

// Informational build identity only; it cannot issue a runtime capability.
QUESTIFY_DEPLOYMENT_ENVIRONMENT = unconfigured
INFOPLIST_KEY_QuestifyDeploymentEnvironment = $(QUESTIFY_DEPLOYMENT_ENVIRONMENT)

INFOPLIST_KEY_NSCameraUsageDescription = Use the camera only when you choose to scan a QR code, take a photo for a play task, a city stamp, a post or your profile, or view an augmented-reality scene. Merchants also use it to photograph aftercare evidence. Nothing is captured in the background.

// Explicit deployment identity for isolated local session persistence; no default realm.
QUESTIFY_SESSION_REALM =
INFOPLIST_KEY_QuestifySessionRealm = $(QUESTIFY_SESSION_REALM)

// CITY board region (backend city_game_board.region_id). Empty means no CITY board lease.
QUESTIFY_CITY_GAME_REGION =
// DEBUG e2e only: the TEST backend board region. Release stays empty until production ships a board.
QUESTIFY_CITY_GAME_REGION[config=Debug] = gaps-a-test
INFOPLIST_KEY_QuestifyCityGameRegion = $(QUESTIFY_CITY_GAME_REGION)

// P0-5 / P1-1 owner values (WeChat AppID, Universal Link, link domain): Config/OwnerValues.xcconfig,
// docs/release/owner-values.md. Public identifiers only; the WeChat AppSecret stays on the backend.
#include "OwnerValues.xcconfig"
// 1 only once the official WechatOpenSDK is in Vendor/WechatOpenSDK/WechatOpenSDK.xcframework (App/QFWeChatSDKBridge.m).
QUESTIFY_WECHAT_SDK_APPROVED = 0
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) QUESTIFY_WECHAT_SDK_APPROVED=$(QUESTIFY_WECHAT_SDK_APPROVED)
// YES only after the owner enables Associated Domains on the App ID and hosts the AASA file
// (docs/release/aasa-template.json). NO keeps signing working with the current provisioning profile.
QUESTIFY_ASSOCIATED_DOMAINS = NO
QUESTIFY_APP_ENTITLEMENTS_NO = Config/Questify.entitlements
QUESTIFY_APP_ENTITLEMENTS_YES = Config/QuestifyAssociatedDomains.entitlements

#include? "Local.xcconfig"

// Declares the explicit iPhone step-reading purpose; does not grant or enable access.
INFOPLIST_KEY_NSMotionUsageDescription = Step counts are read from this iPhone only when you view a walking activity. Step counts don't prove you walked and don't unlock rewards.

// OWN-D-07: When-In-Use purpose only, no Always key. Background updates run only while a roam walk the player
// started holds them (the location background mode in Info.plist, SessionBackgroundLocationTracker).
// P-050: a started, not yet ended city orientation run also reads in the background (CityOrientationLocationObserver).
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = Your location is used only when you choose to roam, play a location-based activity or find nearby places. When you tap I'm Here, your location is read once to confirm you're near the start or the place you're visiting. During a roam walk you started, your route keeps recording in the background, even with the screen locked, and iOS shows the location indicator; it stops when you pause or finish the walk, sign out, or turn off roam location in Privacy. During a city orienteering run you started, your walking distance keeps counting in the background with the same indicator until the run ends. Your location is never shared with other players.

// Declares the explicit NPC voice recording and local sound-peak gameplay amplitude measurement purposes; does not grant or enable access.
INFOPLIST_KEY_NSMicrophoneUsageDescription = The microphone is used only when you choose to record a voice message, talk to or set up an NPC voice, or measure sound peak levels on this iPhone in sound-based gameplay. Voice messages are uploaded for a safety check only after you confirm, and sending needs a second confirmation. In sound challenges, amplitude is measured on device without uploading audio. The microphone turns off when you finish and never runs in the background.
