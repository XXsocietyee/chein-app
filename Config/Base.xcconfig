// Temporary identifier only. Apple Team/Bundle ID require release-owner confirmation.
PRODUCT_BUNDLE_IDENTIFIER = invalid.example.questify.ios
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
TARGETED_DEVICE_FAMILY = 1,2
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 2
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Questify
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
CODE_SIGN_STYLE = Automatic
// No ATS relaxation, credentials, or service endpoints. The only entitlement is Sign in with Apple (Config/Questify.entitlements, set on the app target).

// Set only an approved public API base URL; never put secrets in build settings.
QUESTIFY_MARKET = CN
INFOPLIST_KEY_QuestifyMarket = $(QUESTIFY_MARKET)
QUESTIFY_API_BASE_URL =
INFOPLIST_KEY_QuestifyAPIBaseURL = $(QUESTIFY_API_BASE_URL)

// Informational build identity only; it cannot issue a runtime capability.
QUESTIFY_DEPLOYMENT_ENVIRONMENT = unconfigured
INFOPLIST_KEY_QuestifyDeploymentEnvironment = $(QUESTIFY_DEPLOYMENT_ENVIRONMENT)

INFOPLIST_KEY_NSCameraUsageDescription = Use the camera only when you choose to scan a QR code, take a photo for a play task, a city stamp, a post or your profile, or view an augmented-reality scene. Merchants also use it to photograph aftercare evidence. Nothing is captured in the background.

// Explicit deployment identity for isolated local session persistence; no default realm.
QUESTIFY_SESSION_REALM =
INFOPLIST_KEY_QuestifySessionRealm = $(QUESTIFY_SESSION_REALM)

// CITY board region (backend city_game_board.region_id). Empty means no CITY board lease.
QUESTIFY_CITY_GAME_REGION =
// DEBUG e2e only: the TEST backend board region. Release stays empty until production ships a board.
QUESTIFY_CITY_GAME_REGION[config=Debug] = gaps-a-test
INFOPLIST_KEY_QuestifyCityGameRegion = $(QUESTIFY_CITY_GAME_REGION)

#include? "Local.xcconfig"

// Declares the explicit iPhone step-reading purpose; does not grant or enable access.
INFOPLIST_KEY_NSMotionUsageDescription = Read step counts from this iPhone when you choose to review a walking activity. Counts are not proof of walking and do not unlock rewards.

// OWN-D-07: When-In-Use purpose only, no Always key. Background updates run only while a roam walk the player
// started holds them (the location background mode in Info.plist, SessionBackgroundLocationTracker).
// P-050: a started, not yet ended city orientation run also reads in the background (CityOrientationLocationObserver).
INFOPLIST_KEY_NSLocationWhenInUseUsageDescription = Use your location when you choose to roam, play a location-based activity or find nearby places. When you tap I've arrived, location is read once to confirm you are near the start or a place you are visiting. While a roam walk you started is running, your route keeps recording in the background, also when the screen is locked, and the system shows the location indicator; it stops when you pause or finish the walk, sign out, or withdraw roam location in Privacy. While a city orientation run you started is in progress, its walked distance keeps counting in the background, also when the screen is locked, and the system shows the location indicator; it stops when the run ends. Your location is never shared with other players.

// Declares the explicit NPC voice recording and local sound-peak gameplay amplitude measurement purposes; does not grant or enable access.
INFOPLIST_KEY_NSMicrophoneUsageDescription = Use the microphone only when you choose to record an IM voice message, talk to or set up an NPC voice, or measure sound peak levels locally on this iPhone during interactive sound gameplay. IM recordings are uploaded only after your separate confirmation for the original audio safety check; sending the message requires another confirmation. Sound-challenge amplitude is measured on device without uploading audio, and microphone access stops when you finish and never runs in the background.
