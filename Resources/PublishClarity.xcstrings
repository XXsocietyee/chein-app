{
  "sourceLanguage": "en",
  "strings": {
    "check.agreement.localOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local check still lists problems the server did not report. Fix them or sync, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地检查仍有问题而服务端未报告，请修改或同步后重新检查。"
          }
        }
      }
    },
    "check.agreement.savedVersionDiffers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This result covers the version saved on the server. Your newer edits are not checked yet: save, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此结果针对服务端已保存的版本，本机较新的修改尚未检查：请先保存再重新检查。"
          }
        }
      }
    },
    "check.agreement.serverOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server found problems the local check did not. Sync your draft, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端发现了本地检查没有发现的问题，请同步草稿后重新检查。"
          }
        }
      }
    },
    "check.clean": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No problems in the saved version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的版本没有问题。"
          }
        }
      }
    },
    "check.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check didn't finish. Your draft is kept; try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发布检查暂未完成，草稿仍保留，请重试。"
          }
        }
      }
    },
    "check.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks the version saved on the server against the publishing rules. Doesn't publish anything."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按发布规则检查服务端已保存的版本，不会发布。"
          }
        }
      }
    },
    "check.level.error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocks publishing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会拦截发布"
          }
        }
      }
    },
    "check.level.warn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note, does not block"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示，不拦截"
          }
        }
      }
    },
    "check.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查…"
          }
        }
      }
    },
    "check.rerun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检查"
          }
        }
      }
    },
    "check.run": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run server check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行服务端检查"
          }
        }
      }
    },
    "check.stale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor changed since the last check. Check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑内容已变化，请重新检查。"
          }
        }
      }
    },
    "check.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server publish check"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端发布检查"
          }
        }
      }
    },
    "check.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server check isn't available in this build. The local checks below still apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本无法使用服务端检查，下方本地检查仍有效。"
