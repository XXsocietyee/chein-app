    "list.soldEditScope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tickets are sold. The editor only opens the parts the server still allows to change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有人购票，编辑器只开放服务端仍允许修改的部分。"
          }
        }
      }
    },
