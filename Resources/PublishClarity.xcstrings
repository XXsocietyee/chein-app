    "status.gate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Startable only covers the published content. Sign-up and play times are checked when a run starts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“可开局”只表示已发布内容就绪；报名与可玩时段在开局时另行校验。"
