    "next.draft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved as a draft. It is not public until you publish it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存为草稿，发布前不会公开。"
          }
        }
      }
    },
    "next.live": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Published. Current visibility, sale and play status are read from the server below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发布。可见、售卖与可玩状态以下方服务端读回为准。"
          }
        }
      }
    },
    "next.rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your content is kept. Fix the reasons above, then submit again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容仍保留，按上面的原因修改后重新提交。"
          }
        }
      }
    },
    "next.review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The topic and the play modules it uses are reviewed together. Check the status here or in My projects; you don't need to publish again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题与引用的玩法将一起审核。可在这里或“我的项目”查看进度，无需再次发布。"
          }
        }
      }
    },
    "next.status": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the current status below before changing anything."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改前请先读取下方的当前状态。"
          }
        }
      }
    },
    "next.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result could not be confirmed. Read the current status; the original request is not sent again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果暂时无法确认。请读取当前状态，原请求不会再次发送。"
