                  "value": "About %lld minute"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "About %lld minutes"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预计 %lld 分钟"
          }
