    "workshopCommerce.purchaseBoundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase does not publish content or start a run. Your purchased version and license scope remain frozen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买不等于发布或开局。版本与授权范围保持冻结。"
          }
        }
      }
    },
    "workshopCommerce.claimFree": {
