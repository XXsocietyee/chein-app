    "workshopCommerce.recover": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover original order and licenses"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查回原订单与授权"
          }
        }
      }
    },
    "workshopCommerce.digitalChannelBoundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Digital modules use separately approved Apple In-App Purchase only. Pending or canceled system prompts do not establish payment or a license. Recover the original order instead of buying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字模组仅使用独立获批的 Apple App 内购买。系统付款待处理或取消均不代表付款或授权结果，请查回原订单，不要重复购买。"
          }
        }
      }
    },
    "workshopCommerce.confirmationQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this price, pinned version and frozen terms?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认当前价目、固定版本和条款？"
          }
        }
      }
    },
    "workshopCommerce.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认"
          }
        }
      }
    },
