    },
    "workshopCommerce.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Module commerce access is not approved for this account and region. No purchase has been started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账号和地区尚未获批访问模组交易服务，未发起购买。"
