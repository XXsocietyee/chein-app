          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "workshopCommerce.error.offerUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approved offer could not be loaded. No purchase was started."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已批准价目，未发起购买。"
          }
        }
      }
    },
    "workshopCommerce.error.purchaseUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is not confirmed. The original request is retained. Recover it rather than purchasing again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚未确认。保留原请求，请查回，不要重新购买。"
          }
        }
      }
    },
    "workshopCommerce.error.recoveryUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request is still unresolved. No new order or payment was submitted, and no license was inferred."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求仍待核实。没有重新下单、付款或推断已授权。"
          }
        }
      }
    },
    "workshopCommerce.error.paymentUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment outcome is unknown. Recover the retained original order; a new payment order will not be created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支付结果未知。原订单保留，请查回；不会再次创建支付单。"
          }
        }
      }
    },
    "workshopCommerce.error.cancelUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider has not confirmed cancellation. Recover the original order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消尚未获服务方确认，请沿原订单查回。"
          }
        }
      }
    },
