{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Club badges"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "俱乐部勋章"
          }
        }
      }
    },
    "loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取…"
          }
        }
      }
    },
    "readError": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the current details."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能读取当前资料。"
          }
        }
      }
    },
    "refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新"
          }
        }
      }
    },
    "unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original result is unconfirmed. Do not create or award again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原操作结果尚未确认，请勿重复创建或颁发。"
          }
        }
      }
    },
    "recover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check original result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看原操作结果"
          }
        }
      }
    },
    "receipt.CREATED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Badge created"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勋章已创建"
          }
        }
      }
    },
    "receipt.GRANTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Badge awarded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勋章已颁发"
          }
        }
      }
    },
    "receipt.ALREADY_GRANTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already awarded; no duplicate award"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前已颁发，本次没有重复颁发"
          }
        }
      }
    },
    "checkResult": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the original result before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次操作前请先查看原结果。"
          }
        }
      }
    },
    "create": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create badge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建勋章"
          }
        }
      }
    },
    "grant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Award badge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颁发勋章"
          }
        }
      }
    },
    "unnamed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unnamed badge"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命名勋章"
          }
        }
      }
    },
    "cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "recipient": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a member"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择成员"
          }
        }
      }
    },
    "confirmGrant": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Award this badge to this member?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向这位成员颁发这枚勋章？"
          }
        }
      }
    },
    "name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Badge name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勋章名"
          }
        }
      }
    },
    "description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Description"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明"
          }
        }
      }
    },
    "limits": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Badge name: up to 120 characters. Description: up to 255."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勋章名最多 120 个字，说明最多 255 个字。"
          }
        }
      }
    },
    "confirmCreate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm creation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认创建"
          }
        }
      }
    },
    "storageUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original operation log could not be verified. Submissions are paused; do not repeat a previous action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法核实原操作记录，已暂停提交；请勿重复之前的操作。"
          }
        }
      }
    },
    "actionNeedsReview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action did not return a confirmed result. Review the current details before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次操作未返回已确认结果，请核对当前资料后再继续。"
          }
        }
      }
    },
    "notSent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action was not sent. Refresh your current identity and confirm again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次操作未发送，请刷新当前身份后重新确认。"
          }
        }
      }
    },
    "historicalResult": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous confirmed result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此前已确认的结果"
          }
        }
      }
    },
    "empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No club badges yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有俱乐部勋章"
          }
        }
      }
    },
    "ownerOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the club owner can create or award badges."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有俱乐部主理人可以创建或颁发勋章。"
          }
        }
      }
    },
    "notAvailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Club badges are not available yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "俱乐部勋章暂未开放。"
          }
        }
      }
    },
    "membersLoading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading members…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取成员名单…"
          }
        }
      }
    },
    "membersError": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load the member list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员名单没加载成功。"
          }
        }
      }
    },
    "membersEmpty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No members yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无成员。"
          }
        }
      }
    },
    "retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载"
          }
        }
      }
    },
    "ownerMark": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Owner"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主理人"
          }
        }
      }
    },
    "confirmGrantDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The member will receive this club badge immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颁发后对方会拿到这枚俱乐部勋章。"
          }
        }
      }
    },
    "confirmGrantConsequence1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This badge is written into the member's badge record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这枚勋章会写入对方的勋章记录"
          }
        }
      }
    },
    "confirmGrantConsequence2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awarding the same badge again checks whether they already hold it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次颁发同一枚勋章时，平台会提示对方是否已经拥有"
          }
        }
      }
    },
    "confirmGrantConsequence3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action cannot be undone; badges cannot be revoked later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不可撤销，目前没有收回勋章的入口"
          }
        }
      }
    },
    "listError": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the badge list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勋章列表没加载成功"
          }
        }
      }
    },
    "refreshError": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't refresh the list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表没刷新成功"
          }
        }
      }
    },
    "allBadges %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All badges · %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部勋章 · %lld 枚"
          }
        }
      }
    },
    "confirmGrantNamed %@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give “%1$@” to %2$@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把「%1$@」颁给 %2$@？"
          }
        }
      }
    }
  },
  "version": "1.0"
}
