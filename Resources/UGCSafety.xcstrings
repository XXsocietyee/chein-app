{
  "sourceLanguage": "en",
  "strings": {
    "ugc.safety.action.block": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block user"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽该用户"
          }
        }
      }
    },
    "ugc.safety.action.contactSupport": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Community rules & support contact"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "社区规范与人工客服联系方式"
          }
        }
      }
    },
    "ugc.safety.action.report": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报"
          }
        }
      }
    },
    "ugc.safety.action.reportContent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报内容"
          }
        }
      }
    },
    "ugc.safety.action.reportUser": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report user"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报用户"
          }
        }
      }
    },
    "ugc.safety.action.unblock": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unblock user"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消屏蔽"
          }
        }
      }
    },
    "ugc.safety.alsoBlockUser": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also block this user and hide their posts and comments"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时屏蔽该用户并隐藏其全部内容与评论"
          }
        }
      }
    },
    "ugc.safety.block.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "ugc.safety.block.confirmButton": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block & Hide Content"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认屏蔽并隐藏内容"
          }
        }
      }
    },
    "ugc.safety.block.confirmMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posts, comments, reviews, and messages from this user will be hidden immediately across all feeds and chats. You can unblock them anytime in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏蔽后，该用户发布的动态、评论、评价与消息将在所有社区、俱乐部与私信中立即隐藏。你可随时在设置中解除屏蔽。"
          }
        }
      }
    },
    "ugc.safety.block.confirmTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block user?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认屏蔽该用户？"
          }
        }
      }
    },
    "ugc.safety.block.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User blocked and content hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已屏蔽该用户并隐藏其内容。"
          }
        }
      }
    },
    "ugc.safety.blockedBanner.hidden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content from a blocked user is hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已隐藏来自被屏蔽用户的内容。"
          }
        }
      }
    },
    "ugc.safety.blockedBanner.profile": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have blocked this user. Their content is hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已屏蔽该用户，其发布内容已隐藏。"
          }
        }
      }
    },
    "ugc.safety.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "ugc.safety.detailsHeader": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional details (optional)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补充说明（可选）"
          }
        }
      }
    },
    "ugc.safety.detailsPlaceholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe what happened so moderators can review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请补充违规情况，便于审核团队核查处理"
          }
        }
      }
    },
    "ugc.safety.emergencyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If anyone is in immediate danger, contact local emergency services right away. Urgent reports are prioritized by moderation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如存在现实人身危险，请立即联系当地警方或急救机构。高优安全举报将进入加急人工审核通道。"
          }
        }
      }
    },
    "ugc.safety.error.signedOut": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to submit safety actions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先登录后再提交举报或屏蔽操作。"
          }
        }
      }
    },
    "ugc.safety.error.submitFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to complete safety request. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交失败，请稍后重试。"
          }
        }
      }
    },
    "ugc.safety.menu.accessibility": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safety actions: report or block"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全选项：举报或屏蔽"
          }
        }
      }
    },
    "ugc.safety.moderation.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User content is subject to automated filtering and moderation review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有用户发布内容均受系统自动过滤及人工审核机制约束。"
          }
        }
      }
    },
    "ugc.safety.reasonHeader": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a reason"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择违规原因"
          }
        }
      }
    },
    "ugc.safety.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload reasons"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新加载举报原因"
          }
        }
      }
    },
    "ugc.safety.sheet.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports are reviewed under community safety guidelines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有举报均按社区安全规范审核处理，违规内容将被下架。"
          }
        }
      }
    },
    "ugc.safety.sheet.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report & Safety"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报与安全"
          }
        }
      }
    },
    "ugc.safety.status.selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择"
          }
        }
      }
    },
    "ugc.safety.status.urgent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Urgent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高优处理"
          }
        }
      }
    },
    "ugc.safety.submit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit report"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交举报"
          }
        }
      }
    },
    "ugc.safety.submitted.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for helping keep the community safe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢你的反馈，审核团队会尽快核查处理。"
          }
        }
      }
    },
    "ugc.safety.submitted.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report submitted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报已提交"
          }
        }
      }
    },
    "ugc.safety.unblock.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User unblocked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消屏蔽该用户。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
