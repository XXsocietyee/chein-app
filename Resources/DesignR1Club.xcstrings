        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已创建 %ld 个俱乐部，已达上限。"
          }
        }
      }
    },
    "r1club.quota.over": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have created %ld clubs; the limit is %ld. You cannot create another one for now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已创建 %ld 个俱乐部，上限是 %ld 个，暂时不能再创建新的俱乐部。"
          }
        }
      }
    },
    "r1club.quota.overTag": {
      "localizations": {
