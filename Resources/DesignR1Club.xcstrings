    "r1club.member.consequence.remove.line1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They leave the club and lose member-only access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方将离开俱乐部，失去成员权限"
          }
        }
      }
    },
    "r1club.member.consequence.remove.line2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They can apply again later"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后对方仍可重新申请加入"
          }
        }
      }
    },
    "r1club.member.consequence.remove.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove member"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除成员"
          }
        }
      }
    },
    "r1club.member.consequence.tempBan.line1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They can't post, comment or sign up until the suspension ends"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "封禁期内不能发帖、评论或报名"
          }
        }
      }
    },
    "r1club.member.consequence.tempBan.line2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They are told the reason and the end date"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方会收到原因和解封时间"
          }
        }
      }
    },
    "r1club.member.consequence.tempBan.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspend member"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时封禁成员"
          }
        }
      }
    },
