    "member.privacy.sheetBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is used only while you roam, play, or turn on home-city location. Photos, text, and recordings are sent to a third-party model only after you agree separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位只在你漫游、游玩或开启首页城市定位时使用；照片、文字和录音只在你单独同意后才会交给第三方模型处理。"
          }
        }
      }
    },
