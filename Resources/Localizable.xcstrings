    "nativeEnrollment.recoveryProof": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The enrollment result is uncertain. Check status or resend the identical saved proof. A new key will not be created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
