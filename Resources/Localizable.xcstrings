          }
        }
      }
    },
    "在老书店延续出的阅读空间里，翻翻海派文化与文学主题的书。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse books on Shanghai-style culture and literature in a reading room that carries on an old bookshop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在老书店延续出的阅读空间里，翻翻海派文化与文学主题的书。"
          }
        }
