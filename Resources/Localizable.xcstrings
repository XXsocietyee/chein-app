    "team.leave.consequence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving removes team-chat access and does not refund your ticket. A captain passes leadership to the earliest-joined remaining teammate; a sole-member team disbands. Returning requires a new invitation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退队会失去队伍群聊入口，不会退票。队长将移交给最早加入的队员；只剩一人时队伍解散。此操作不可撤销，重新加入需要新的邀请。"
          }
        }
      }
    },
    "team.leave.consequence.leader": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving doesn't refund your ticket; it stays valid. You lose team-chat access. Captain passes to the earliest-joined teammate; if you're the only one left, the team disbands. This can't be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退队不会同步退票，你的票仍然有效。你会失去队伍群聊入口；队长会移交给最早加入的队员，只剩你一人时队伍直接解散。此操作不可撤销。"
          }
        }
      }
    },
    "team.leave.consequence.member": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving doesn't refund your ticket; it stays valid. You lose team-chat access, and rejoining needs a new invitation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退队不会同步退票，你的票仍然有效。你会失去队伍群聊入口，重新加入需要新的邀请。"
          }
        }
      }
    },
