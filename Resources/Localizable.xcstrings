    "bank.withdrawal.disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuing sends this amount, account holder name, bank name, bank account number, and phone number to the platform for a withdrawal check. Current bank-information consent must already be verified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续操作会向平台发送本次金额、姓名、银行名称、银行账号及电话，用于提现确认；需先验证当前版本的银行卡信息收集同意记录。"
          }
        }
      }
    },
    "bank.withdrawal.expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This confirmation expired. Verify the earlier request before starting again."
