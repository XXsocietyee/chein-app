    "roam.live.ruleFinish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End your roam to see your exploration XP and shops visited. Your walk is saved to your history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束漫游后查看探索值和探店数，本次漫游会存入漫游记录。"
          }
        }
      }
    },
