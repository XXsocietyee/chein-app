    "merchantKnowledge.error.encoding": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This draft could not be checked. Review its fields and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查此草稿，请检查字段后重试。"
          }
        }
      }
    },
    "merchantKnowledge.error.instant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a valid ISO instant with a four-digit year and a time zone, at most 30 UTF-16 units."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用有效的 ISO 时间，包含四位年份及明确时区，不超过 30 个 UTF-16 单位。"
          }
        }
      }
    },
    "merchantKnowledge.error.order": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end must be strictly later than the start. Opening hours must stay within the same day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束时间须严格晚于开始时间，营业时间须在同一天内。"
          }
        }
      }
    },
    "merchantKnowledge.error.price": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an integer from 0 to 100,000,000 in minor currency units, using digits only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 0 至 100,000,000 的整数最小货币单位，仅使用数字。"
          }
        }
      }
    },
    "merchantKnowledge.error.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text is required, must stay within the field’s limit, and cannot contain line breaks or control characters. Emoji can use two UTF-16 units."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本不能为空或超长，且不得含换行或控制字符。部分表情占两个 UTF-16 单位。"
          }
        }
      }
    },
    "merchantKnowledge.error.timeZone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a recognized IANA time zone or valid UTC offset, at most 64 UTF-16 units."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用有效的 IANA 时区或 UTC 偏移，不超过 64 个 UTF-16 单位。"
          }
        }
      }
    },
    "merchantKnowledge.errors": {
      "extractionState": "manual",
      "localizations": {
