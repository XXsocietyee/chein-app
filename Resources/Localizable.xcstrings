    "上海市虹口区四川北路2288号": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2288 North Sichuan Road, Hongkou District, Shanghai"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上海市虹口区四川北路2288号"
          }
        }
      }
    },
    "在树荫与湖边走一段，听听居民合唱，再接着逛周边的文学街巷。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk under the trees and by the lake, listen to the residents' choirs, then wander the literary streets nearby."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在树荫与湖边走一段，听听居民合唱，再接着逛周边的文学街巷。"
          }
        }
      }
    },
    "1927·鲁迅与内山纪念书局": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
