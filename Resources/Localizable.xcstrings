        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创作者、打款、税务、版权和风控审批仍在原有的资质/结算流程中进行。读取自有历史记录不会授予付款、退款、申请结算或发布的权限。"
          }
