    "roam.live.presenceOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby players can see you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近玩家可以看到你"
          }
        }
      }
    },
    "roam.live.presencePrivacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby players see your rough location, nickname, avatar and progress while you roam. Pausing or leaving stops sharing; it can take up to five minutes to disappear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "漫游时，附近玩家会看到你的大致位置、昵称、头像和漫游进度。暂停或离开即停止分享，最多五分钟后消失。"
          }
        }
      }
    },
    "roam.live.purpose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After you choose Start, foreground location is used to measure this walk, reveal visited tiles and verify arrivals you choose. Your precise fixes and route stay in memory. Pending tiles and measured distance are protected on this device for recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择开始后，仅在前台使用定位，记录本次步行距离、点亮经过的格子，并核验你主动选择的到点操作。精确定位和轨迹仅保留在内存中；待确认格子与实测距离受保护地保存在本机，用于恢复核对。"
          }
        }
      }
    },
    "roam.live.purposeTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk and discover"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步行探索城市"
          }
        }
      }
    },
