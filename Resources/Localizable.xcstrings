          }
        }
      }
    },
    "guideXcx.classicDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check in stop by stop and set out together at the start time. Good for meetups and story routes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按顺序打卡通关，到点了大家一起出发。适合约人、适合有剧情的路线。"
          }
        }
      }
    },
    "guideXcx.classicTag": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group · In order"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组队 · 按顺序"
          }
        }
      }
    },
    "guideXcx.detailDisclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The play version is not labelled yet. This guide explains how to play; the play page decides the actual tasks, completion conditions and rewards."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用玩法版本暂未标注；教程用于说明，实际任务、完成条件与奖励以游玩页为准。"
          }
        }
      }
    },
