      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads only the original source→target selection and the result of the same upgrade request. It does not query the upgradable catalog, re-stage, install, cancel or delete the journal. Old licenses, drafts and runs are not overwritten."
          }
