      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter all fields. Use a positive amount with at most 12 integer digits and 2 decimal places. Name/account limits are 64 characters, bank 128, and phone 32."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写所有项目。金额须大于零，最多12位整数和2位小数；姓名、账号最多64字符，银行名称128字符，电话32字符。"
          }
        }
      }
