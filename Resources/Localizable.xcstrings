    "official.organizer.schedule.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After passing publish checks, the event becomes visible to players and progresses on the configured schedule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过发布检查后对报名可见，按设定的报名与开始时间自动推进。"
          }
        }
      }
    },
    "official.organizer.schedule.c1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missions, bound locations, and fulfillment rules take effect together."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
