    "official.organizer.schedule.c2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event details become visible once scheduled; stopping later requires Pause."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
