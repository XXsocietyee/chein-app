    "official.organizer.pause.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Players see the event as paused and your notice policy is recorded as pending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停后玩家侧显示活动已暂停，通知策略记为待执行。"
          }
        }
      }
    },
    "official.organizer.pause.c1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New registrations, arrival evidence, and fulfillment changes are blocked; the end time stays unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停期间不能报名、到达证据不计入、承接方不能变更履约；原定结束时间不变"
          }
        }
      }
    },
    "official.organizer.pause.c2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The notice policy is recorded as pending and does not auto-broadcast."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写的通知策略不会自动群发，状态记为「待执行」"
          }
        }
      }
    },
    "official.organizer.pause.c3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuming re-runs publish checks; if the end time passes while paused, it moves to awaiting settlement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复前平台会重新检查主办与履约；到结束时间仍未恢复会直接转入待结算"
          }
        }
      }
    },
    "official.organizer.pause.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause event"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停活动"
          }
