    "roam.live.ruleExplore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no fixed route. Start, then walk to light up the blocks you pass. Paused time and jumpy GPS don't count."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有固定路线。开始后边走边点亮经过的街区，暂停和定位跳动不计入。"
          }
        }
      }
    },
