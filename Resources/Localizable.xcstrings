            "value": "Cancel your team's task"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消本队操作"
          }
        }
      }
    },
    "执行已选方案": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carry out the selected plan"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行已选方案"
          }
        }
      }
    },
    "意向由当前队长签署，但不锁定或消耗物资。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current captain signs the pledge. No materials are locked or used yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "意向由当前队长签署，不会锁定或消耗物资。"
          }
        }
      }
    },
    "仅锁定本队原意向中的物资；托管不是执行完成。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locks only the materials in your team's pledge. Locking in doesn't carry out the plan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只锁定本队意向里的物资；托管不等于方案已执行。"
          }
        }
      }
    },
    "释放方案锁、本轮投票与签名；不会释放独立交易锁。所有队伍须重新核对。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the plan releases plan-locked materials and this round's votes and signatures. Trade-locked materials stay locked. Every team needs to check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改案只释放方案锁定的物资和本轮投票、签名；交易锁定的物资不会释放。所有队伍需要重新确认。"
          }
        }
      }
    },
    "会影响当前方案、票轮或签名；仅代表本队当前队长。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This affects the current plans, round and signatures, on behalf of your team's current captain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次操作会影响当前方案、票轮与签名，仅代表本队当前队长。"
          }
        }
      }
    },
    "仅原系统确认各队签名、准确托管、真实操作 PASS 与费用后结算。选定不等于已执行。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan runs only after every team's signature, locked materials, the task pass and costs are confirmed. Selected doesn't mean carried out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各队签名、托管物资、操作任务通过和费用都确认后才会结算。选定不等于已执行。"
          }
        }
      }
    },
    "开始只是原操作实例建立，仍须进入真实题组；不会由界面制造 PASS。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting opens the task. You still need to complete it to pass."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始只是开启操作任务，仍需完成任务才算通过。"
          }
        }
      }
    },
    "取消当前本队方案操作及其对应证明；不会执行方案或推断退款。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancels your team's task and its proof. The plan isn't carried out and nothing is refunded automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消本队当前的方案操作及其证明；不会执行方案，也不会自动退款。"
          }
        }
      }
    },
    "按当前原票轮、版本和队长签署；结果以本次原回执为准。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed by the current captain for this round. The confirmed result decides."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由当前队长按本轮签署，结果以确认的操作记录为准。"
          }
        }
      }
    },
    "本局另有原操作待确认，请回原入口核对；这里不会替它清锁。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another action in this game is still waiting for its result. Check it where you started it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本局还有一个操作在等待结果，请回到发起的地方确认。"
          }
        }
      }
    },
    "已核对原回执；原请求日志保留，未开放后续写入。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result checked. New actions aren't open yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已确认操作结果，暂未开放新的操作。"
          }
        }
      }
    },
    "原请求明确失败，未换 ID 重做。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That action didn't go through. Nothing was resent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次操作未成功，没有重复提交。"
          }
        }
      }
    },
    "已取得本次执行原回执并回读当前公共结果；终态以原结果 terminal 为准。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan carried out. The latest result is below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方案已执行，最新结果见下方。"
          }
        }
      }
    },
    "本次原请求已回执并回读。提出、意向、投票、选定及托管均不等于已执行。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done. Proposing, pledging, voting, selecting and locking in don't carry out the plan yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已完成。提出、意向、投票、选定和托管都不等于方案已执行。"
          }
        }
      }
    },
    "原请求结果或回读仍待确认；已保留原 ID、完整命令与安全锁，只读原回执，绝不自动重发。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result isn't confirmed yet. The app keeps checking this same action and never sends it twice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果待确认，请刷新后再试。不会自动重复提交。"
          }
        }
      }
    },
    "本局另有原操作待确认，请回原入口恢复；这里不清除其它操作的锁。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another action in this game is still waiting for its result. Finish it where you started it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本局还有一个操作在等待结果，请回到发起的地方处理。"
          }
        }
      }
    },
    "原安全日志未能确认，不能提交新方案动作。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save this action safely on your device, so it wasn't sent. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在本机安全记录这次操作，未提交，请重试。"
          }
        }
      }
    },
    "本队、队长、版本、权限或票轮已变化／尚未确认。请刷新后重新核对；未据此认定操作成功。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your team, captain or round changed. Refresh and check again; the action wasn't counted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态已变化，请刷新后重新确认；本次操作未生效。"
          }
        }
      }
    },
    "templateAdoption.shelfNotice %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will appear on the template shelf, where others can copy it as a starting draft."
          }
        },
