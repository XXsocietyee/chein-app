    "merchantVoice.reset.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only unuploaded samples on this device will be cleared. No server files will be deleted and the microphone will stay off until you tap Record again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅清除当前设备上尚未上传的样本。不会删除服务器文件或开启麦克风；继续时需再次点击录制。"
          }
