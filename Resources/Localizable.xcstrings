    "看里弄与老公寓的门窗细节，把阅读上海的起点放在居民日常里。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at the doors and windows of the lanes and old apartments, and start reading Shanghai from its residents' everyday life."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看里弄与老公寓的门窗细节，把阅读上海的起点放在居民日常里。"
          }
        }
      }
    },
    "鲁迅公园": {
