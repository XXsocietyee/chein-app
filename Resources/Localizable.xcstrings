          "stringUnit": {
            "state": "translated",
            "value": "确认队伍操作"
          }
        }
      }
    },
    "team.consequence.disband.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All teammates are removed and the team chat closes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部队员会被移出队伍，队伍群聊同时关闭"
          }
        }
      }
    },
    "team.consequence.disband.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No refunds are triggered; everyone's tickets stay valid"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会触发任何退款；队员各自的票仍然有效，需要自己去核销"
          }
        }
      }
    },
    "team.consequence.disband.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action cannot be undone; team and chat history cannot be restored"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不可撤销，队伍与聊天记录无法恢复"
          }
        }
      }
    },
    "team.consequence.leave.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You lose team-chat access"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会失去队伍群聊入口"
          }
        }
      }
    },
    "team.consequence.leave.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you are the captain, leadership passes to the earliest-joined teammate; if only you remain, the team disbands"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是队长的话，队长会移交给最早加入的队员；只剩你一人时队伍直接解散"
          }
        }
      }
    },
    "team.consequence.leave.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action cannot be undone; you need a new invitation to rejoin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不可撤销，需要重新被邀请才能回到这支队伍"
          }
        }
      }
    },
    "team.consequence.remove.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They lose team-chat access and receive an inbox notice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方会收到站内通知，并失去队伍群聊入口"
          }
        }
      }
    },
    "team.consequence.remove.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removal does not refund tickets; their ticket stays valid"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移出不同步退票，对方的票仍然有效"
          }
        }
      }
    },
    "team.consequence.remove.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action cannot be undone; they cannot rejoin with an invite code or apply again"
          }
        },
        "zh-Hans": {
