          "stringUnit": {
            "state": "translated",
            "value": "Up to 30 questions. Question: 200 UTF-16 units; answer: 600. All text is plain text, with no control characters or line breaks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 30 组问答；问题不超过 200、回答不超过 600 个 UTF-16 单位。所有内容均为纯文本，不支持控制字符或换行。"
          }
