    "merchantKnowledge.hoursHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to seven unique days. Use 24-hour HH:mm and an IANA zone or UTC offset. Closing must be later on the same day; overnight hours are unsupported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多七个不重复的星期。使用 24 小时制 HH:mm 及 IANA 时区或 UTC 偏移。结束须晚于同日开始时间，暂不支持跨夜营业。"
          }
        }
      }
    },
    "merchantKnowledge.memoryOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept only in this NPC page’s memory. Leaving this page, signing out, changing accounts, or putting the app in the background clears it. Nothing is saved to disk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅暂存在此 NPC 页面内存中。离开此页、退出登录、切换账号或应用进入后台后清除，不写入设备存储。"
          }
        }
      }
    },
