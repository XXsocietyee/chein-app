    "squareReport.legacyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy post report: your selected reason is sent with the post ID. This does not create a versioned-policy case."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版动态举报：内容编号与所选原因一起提交，不会生成版本化规则案件。"
          }
        }
      }
    },
    "squareReport.legacyLikeHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This likes or unlikes the post once. If the result isn't confirmed, it stays locked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将切换一次当前动态的点赞状态，结果未确认时保持锁定。"
          }
        }
      }
    },
    "squareReport.legacyReason.0": {
