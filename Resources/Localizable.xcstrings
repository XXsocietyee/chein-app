        }
      }
    },
    "official.organizer.resume.c2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the end time has already passed, it moves to awaiting settlement instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果活动已过结束时间，会转入待结算而不是恢复运行"
          }
        }
      }
    },
    "official.organizer.resume.confirm": {
