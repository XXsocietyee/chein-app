    "guideXcx.docsEmptyDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They will appear here once published"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容上线后会出现在这里"
          }
        }
      }
    },
    "guideXcx.docsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The play page's rules apply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际玩法以游玩页规则为准"
          }
        }
      }
    },
    "guideXcx.freeDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every stop is open; start wherever you like. Get a pass and play any time without waiting for a full group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点位全开，想从哪个开始都行。买张通行证随时开玩，不用等人凑齐。"
          }
        }
      }
    },
    "guideXcx.freeTag": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anytime · On your own"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时 · 自己走"
          }
        }
      }
    },
    "guideXcx.go": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a look"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去看看"
          }
        }
      }
    },
    "guideXcx.heroDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rules to learn first. Pick a way to set out and the city will tell the rest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用先学规则。挑一种出发方式，城市自己会讲下去。"
          }
        }
      }
    },
    "guideXcx.heroEmphasis": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ready when you are"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即开即玩"
          }
        }
      }
    },
    "guideXcx.heroLead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three ways to play, "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三种玩法，"
          }
        }
      }
    },
    "guideXcx.roamDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light up the city's fog as you walk, with no tasks and no finish line. A stroll on the way counts too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "边走边点亮城市迷雾，没有任务也没有终点。顺路散个步也算数。"
          }
        }
      }
    },
    "guideXcx.roamTag": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No finish · Stroll"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无终点 · 散步"
          }
        }
      }
    },
