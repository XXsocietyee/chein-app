          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 40 个商品，名称不超过 120 个 UTF-16 单位。价格为 0 至 100,000,000 的整数最小货币单位，币种为三个大写英文字母。请核对所用币种的最小单位换算。"
          }
