        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整结构化草稿超过 16,000 个 UTF-8 字节，请缩短或减少部分条目。"
          }
        }
      }
    },
    "merchantKnowledge.error.clock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a valid 24-hour HH:mm time, such as 09:00."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用有效的 24 小时制 HH:mm 时间，例如 09:00。"
          }
        }
      }
    },
    "merchantKnowledge.error.count": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many rows in this section."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分类的条目数量超过上限。"
          }
        }
      }
    },
    "merchantKnowledge.error.currency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use exactly three uppercase ASCII letters, such as CNY or USD."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用三个大写英文字母，例如 CNY 或 USD。"
          }
        }
      }
    },
    "merchantKnowledge.error.day": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a day from Monday through Sunday."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择星期一至星期日。"
          }
        }
      }
