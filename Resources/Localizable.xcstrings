    "growthNormalEntry.leaderboard.hold": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous rankings aren't available right now. Your personal growth records are shown separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
