      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prepared attestation is saved only in this device’s protected storage until you confirm enrollment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
