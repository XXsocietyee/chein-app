      }
    },
    "official.organizer.resume.c1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumed events return to the phase matching the current time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复后活动按当前时间回到对应阶段（已排期/报名中/进行中）"
