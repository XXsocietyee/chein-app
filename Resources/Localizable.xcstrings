            "value": "Revocation is not yet confirmed. Check status or explicitly retry revoking the same key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未确认撤销结果。请核对状态或主动重试撤销同一密钥。"
          }
        }
      }
    },
    "nativeEnrollment.refresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check saved key and server status"
          }
        },
        "zh-Hans": {
