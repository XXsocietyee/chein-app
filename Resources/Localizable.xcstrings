        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果 body 必须包含 {{choices}} 选择依据。"
          }
        }
      }
    },
    "templateAuthor.preference.error.json": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid JSON. Your current text is retained."
          }
        },
        "zh-Hans": {
