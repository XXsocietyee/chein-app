          "stringUnit": {
            "state": "translated",
            "value": "Uses the original project's save / same-request recovery / freeze after publishing. Existing games do not get retroactive start, arrival or clue grants; TEAM, non-current-node and photographic-memory rules are still not opened by this."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用原项目保存／同请求恢复／发布后冻结。不会给既有局补开始、到达或线索；TEAM、非当前节点、过目不忘规则仍不因此开放。"
          }
        }
      }
    },
