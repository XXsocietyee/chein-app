    "merchantSuggestionEdit.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit only this suggested title, description or feedback text. Saving keeps a candidate; Accept is still a separate action before it changes an eligible empty draft field."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅编辑当前标题、介绍或反馈文案建议。保存只更新建议；仍需另点“接受”，才会填入符合条件的原稿空白字段。"
          }
        }
      }
    },
    "merchantSuggestionEdit.capacity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local editor limit: 16 KiB of UTF-8 text. Ordinary draft validation and publication review still apply later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地建议编辑上限为 16 KiB UTF-8 文本；后续仍需原有草稿校验和发布审核。"
          }
        }
      }
    },
