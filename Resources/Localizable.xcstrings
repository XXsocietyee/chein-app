      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review suggestions before applying them to this local draft. Applying does not save or publish."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先检查建议，再填入当前本地草稿。填入不会保存或发布。"
          }
        }
      }
