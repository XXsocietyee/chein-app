    "merchantKnowledge.error.duplicateDay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each day can appear only once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一个星期只能填写一次。"
          }
        }
      }
