    "merchantKnowledge.untrusted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter public business facts only. This checks structure, not privacy or accuracy. Review submission and AI publication are unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请只填写可公开的经营事实。此处只检查结构，不代表隐私或真实性审核。暂不支持提交审核或用于 AI 回答。"
          }
        }
      }
    },
