    "roam.live.consentCard.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Roam uses your location while a walk is running, to reveal the map, check in and record your route. It keeps recording when the screen is locked, and stops when you pause or finish the walk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
