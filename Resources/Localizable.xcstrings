    "merchant.onboarding.submitConfirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send your store details, contact phone, address, business hours and uploaded business license to Chein for review. Submitting doesn't mean approval or merchant access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将门店资料、联系电话、地址、营业时间和已上传的营业执照提交给城瘾审核。提交不代表审核通过，也不代表已开通商家权限。"
          }
        }
      }
    },
