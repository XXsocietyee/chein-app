    "modUpgrade.r3.compareNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the old and new rights line by line. Anything not listed — people, places, translation or adaptation — isn't included. Choosing a version never widens your license, and old drafts and sessions don't move over automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请逐项比较前后授权。未列入的主体、地点、翻译或改编权不能推定拥有；版本选择不会扩大原许可，旧稿和旧场次不会自动迁移。"
          }
        }
      }
    },
    "modUpgrade.r3.comparisonUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full terms comparison isn't available: an older response or saved record has no details. That doesn't mean the rights are the same or unlimited, so a new upgrade can't be confirmed from it. An existing request can still be viewed read-only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整冻结条款比较暂不可知。旧响应或旧记录没有这些详情，不代表权益相同或全权；不能据此确认新的升级。已存在的原请求仍可只读恢复。"
          }
        }
      }
    },
