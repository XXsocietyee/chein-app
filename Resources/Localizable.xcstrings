    "official.organizer.resume.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The platform re-runs publish checks and rejects with reasons if checks fail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平台会先重新做发布检查，不通过会拒绝恢复并给出原因。"
          }
