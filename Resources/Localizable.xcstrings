    "templateAuthor.preference.error.array": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An array is required; questions and dimensions must not be empty."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此字段必须为数组；题目与维度不能为空。"
          }
        }
      }
    },
    "templateAuthor.preference.error.budget": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check incomplete: this configuration exceeds the local size, depth, preview or work budget. The original text is retained; it has not been declared invalid by the server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查未完成：配置超过本地大小、深度、预览或运算预算。原文已保留，这不表示服务端判定其无效。"
          }
        }
      }
    },
    "templateAuthor.preference.error.combinations": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than 4096 ordinary combinations: split the questionnaire as required by the server contract."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通选项组合超过 4096，请按服务端规则拆分题组。"
          }
        }
      }
    },
    "templateAuthor.preference.error.coupon": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All results must not use the same coupon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有结果不能绑定同一优惠券。"
          }
        }
      }
    },
    "templateAuthor.preference.error.days": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "nextStepDays must be the JSON integer 7 or 30."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "nextStepDays 必须为 JSON 整数 7 或 30。"
          }
        }
      }
    },
    "templateAuthor.preference.error.duplicate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys or dimensions must be unique in their scope."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "key 或维度在所属范围内不得重复。"
          }
        }
      }
    },
