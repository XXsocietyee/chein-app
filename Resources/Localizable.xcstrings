          }
        }
      }
    },
    "nativeEnrollment.resumeKey": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request a fresh challenge for the saved key"
          }
        },
        "zh-Hans": {
