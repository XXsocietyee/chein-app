          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This read returned no records."
          }
        }
      }
    },
    "score.mine.more": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载更多"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load more"
          }
        }
      }
    },
    "score.error.disabled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本人读取尚未配置或已失效，请返回重新进入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal reads are unavailable or have expired. Go back and reopen this page."
          }
        }
      }
    },
    "score.error.denied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原来源拒绝了这次读取，不能据此确认状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source denied this read. The status cannot be confirmed."
          }
        }
      }
    },
    "score.error.malformed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原来源返回的信息无法核实，未据此更新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source response could not be verified and was not used."
          }
        }
      }
    },
    "score.error.unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前读取未成功。已有列表不是最新确认，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This read failed. Any existing list is not a current confirmation. Try again."
          }
        }
      }
    },
    "score.error.stale": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取身份已改变，请返回重新进入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The read identity changed. Go back and reopen this page."
          }
        }
      }
    },
    "score.detail.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
