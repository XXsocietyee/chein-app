{
  "sourceLanguage": "en",
  "strings": {
    "localDraft.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local profile draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机资料草稿"
          }
        }
      }
    },
    "localDraft.inactive": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read current club details before editing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先读取当前俱乐部资料。"
          }
        }
      }
    },
    "localDraft.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected draft storage is unavailable. The existing record wasn't overwritten. Keep this editor open if your latest input hasn't been retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受保护草稿暂不可用，未覆盖原记录。若最新输入尚未保留，请勿退出。"
          }
        }
      }
    },
    "localDraft.ready": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes will be retained only on this device for this account and club."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改只保留在本机，限本账号、本俱乐部。"
          }
        }
      }
    },
    "localDraft.offered": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A draft for this account and club was found. Choose Restore or Discard; nothing has been applied or submitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现本账号、本俱乐部的草稿。请选择恢复或放弃；尚未应用或提交。"
          }
        }
      }
    },
    "localDraft.editing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft retained securely on this device. Not submitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已受保护地保留在本机，尚未提交。"
          }
        }
      }
    },
    "localDraft.conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current details or editing permissions have changed. Compare below, then discard the old draft and read again before editing. It will not be submitted automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前资料或编辑权限已变化。请先对比，再放弃旧草稿并重新读取后编辑；不会自动提交。"
          }
        }
      }
    },
    "localDraft.corrupt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local record could not be verified. It has been preserved and cannot be overwritten or silently deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机记录无法校验，原记录已保留，不会覆盖或静默删除。"
          }
        }
      }
    },
    "localDraft.storageChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local draft changed in another editor or could not be replaced. Its newer record is preserved. Do not close if your latest input is not retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机草稿被其他编辑器改动，或无法替换。较新记录已保留；最新输入未保留时请勿退出。"
          }
        }
      }
    },
    "localDraft.awaitingOriginalResult": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original save result is not confirmed. The draft is retained and will not be replayed. Reading matching details does not resolve an unknown write; its original protection remains."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原保存结果尚未确认。草稿已保留且不会重放；当前资料相同也不代表原写入已确认，原保护锁仍保留。"
          }
        }
      }
    },
    "localDraft.acknowledgedNeedsReadback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original save was acknowledged. Current source details must match before this exact local draft can be cleared. No second save will be sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原保存已确认，须回读匹配的当前资料后才能清除此条草稿；不会再次发送保存。"
          }
        }
      }
    },
    "localDraft.saved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save confirmed and current details read back. This exact local draft was cleared."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存已确认并已回读当前资料，此条本机草稿已清除。"
          }
        }
      }
    },
    "localDraft.restored": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored to the form only. Review and confirm separately to save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅恢复到表单，保存仍需单独预览和确认。"
          }
        }
      }
    },
    "localDraft.restore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复草稿"
          }
        }
      }
    },
    "localDraft.discard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard this local draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃此条本机草稿"
          }
        }
      }
    },
    "localDraft.comparison": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft compared with current details"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿与当前资料对比"
          }
        }
      }
    },
    "localDraft.savedValue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿"
          }
        }
      }
    },
    "localDraft.currentValue": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current source"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前原始资料"
          }
        }
      }
    },
    "localDraft.imageDifference": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The retained image differs from the current source image. References are not displayed or treated as renewed upload authorization."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留图片与当前图片不同；不展示引用地址，也不把旧引用当作新的上传授权。"
          }
        }
      }
    },
    "localDraft.mediaRequiresSelection": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored image references have no live upload receipt. Select the images again through the existing uploader, or explicitly keep the current source images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复的图片引用不带有效上传凭据。请通过原图片入口重新选择，或明确保留当前资料图片。"
          }
        }
      }
    },
    "localDraft.useCurrentImages": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use current source images"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留当前资料图片"
          }
        }
      }
    },
    "localDraft.readFresh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read current details and draft again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取当前资料与草稿"
          }
        }
      }
    },
    "localDraft.localOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local user content only, not a server version or write receipt. Restoring never saves. Discarding never clears an unknown operation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为本机用户内容，不是服务端版本或写入回执。恢复不会保存，放弃不会清除未确认操作。"
          }
        }
      }
    },
    "localDraft.discardTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard only this local draft?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅放弃此条本机草稿？"
          }
        }
      }
    },
    "localDraft.discardMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current source details will be read again. Server data and all pending/unknown write intents are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随后将重新读取当前资料。服务器资料及全部待确认、结果未知的写入意图保持不变。"
          }
        }
      }
    },
    "localDraft.cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "localDraft.keepAndClose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep local draft and close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留本机草稿并关闭"
          }
        }
      }
    },
    "localDraft.discardAndClose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard local draft and close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃本机草稿并关闭"
          }
        }
      }
    },
    "localDraft.closeMessage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your protected local draft for an explicit restore later, or discard only that draft. Unknown writes remain protected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可保留受保护的本机草稿供下次明确恢复，或仅放弃该草稿；结果未知的写入仍受保护。"
          }
        }
      }
    },
    "localDraft.field.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "localDraft.field.clubType": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "类型"
          }
        }
      }
    },
    "localDraft.field.activityPrefs": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity preferences"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动倾向"
          }
        }
      }
    },
    "localDraft.field.city": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "城市"
          }
        }
      }
    },
    "localDraft.field.keywords": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keywords"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关键词"
          }
        }
      }
    },
    "localDraft.field.style": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Style"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风格"
          }
        }
      }
    },
    "localDraft.field.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Description"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "介绍"
          }
        }
      }
    },
    "localDraft.field.logo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头像"
          }
        }
      }
    },
    "localDraft.field.cover": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "封面"
          }
        }
      }
    },
    "localDraft.field.prioritySignupEnabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member priority sign-up"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员优先报名"
          }
        }
      }
    },
    "localDraft.field.memberReservedQuota": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserved quota"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留名额"
          }
        }
      }
    },
    "localDraft.field.joinPolicy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join policy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入会方式"
          }
        }
      }
    }
  },
  "version": "1.0"
}
