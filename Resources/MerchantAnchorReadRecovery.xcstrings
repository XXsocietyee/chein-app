{
  "sourceLanguage": "en",
  "strings": {
    "loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取…"
          }
        }
      }
    },
    "failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current information is unavailable. Retry reads only; verified original results appear separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前信息暂不可用。重试只读取；已核实的原结果单独展示。"
          }
        }
      }
    },
    "notConfigured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This capability is not configured."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此能力尚未配置。"
          }
        }
      }
    },
    "denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access was withdrawn. Private information was cleared. Original requests remain on disk for authorized recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限已撤回，私密信息已清除。原请求记录保留，待重新获准后回读。"
          }
        }
      }
    },
    "unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request is unconfirmed. Keep its identity and read its result; do not resubmit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求结果尚未确认。保留原请求身份，只回读，不重发。"
          }
        }
      }
    },
    "known": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified original save; current information is read separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原保存已核实；当前信息另行读取。"
          }
        }
      }
    },
    "unconfigured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No configuration saved yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未保存配置。"
          }
        }
      }
    },
    "readonly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes are unavailable for this scope or current state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前范围或状态暂不可修改。"
          }
        }
      }
    },
    "working": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理…"
          }
        }
      }
    },
    "original.anchor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified original anchor and request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已核实的原锚点与请求"
          }
        }
      }
    },
    "cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "confirmation.anchor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected anchor coordinates and radius"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中锚点坐标与半径"
          }
        }
      }
    }
  },
  "version": "1.0"
}
