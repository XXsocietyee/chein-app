{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the camera only when you choose to scan a QR code, take a photo for a play task, a city stamp, a post or your profile, or view an augmented-reality scene. Merchants also use it to photograph aftercare evidence. Nothing is captured in the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你主动选择时使用相机：扫描二维码，为玩法任务、城市印章、动态或个人资料拍照，或查看 AR 场景；商家也会用它拍摄售后凭证照片。相机不会在后台拍摄。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is used only when you choose to roam, play a location-based activity or find nearby places. When you tap I'm Here, your location is read once to confirm you're near the start or the place you're visiting. During a roam walk you started, your route keeps recording in the background, even with the screen locked, and iOS shows the location indicator; it stops when you pause or finish the walk, sign out, or turn off roam location in Privacy. During a city orienteering run you started, your walking distance keeps counting in the background with the same indicator until the run ends. Your location is never shared with other players."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你主动选择漫游、参与基于位置的玩法或查找附近地点时使用你的位置。点「我已到达」时只读取一次位置，用来确认你在起点或要到访的地点附近。你开启的漫游进行中，锁屏后仍会记录轨迹，系统会显示定位指示；暂停或结束漫游、退出登录或在隐私页撤回漫游定位后即停止。你开始的城市定向赛进行中，锁屏后仍会累计步行距离，系统会显示定位指示；比赛结束即停止。不会把你的位置分享给其他玩家。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone is used only when you choose to record a voice message, talk to or set up an NPC voice, or measure sound peak levels on this iPhone in sound-based gameplay. Voice messages are uploaded for a safety check only after you confirm, and sending needs a second confirmation. In sound challenges, amplitude is measured on device without uploading audio. The microphone turns off when you finish and never runs in the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你主动选择录制站内语音消息、与 NPC 语音对话、设置 NPC 声音，或在声音互动玩法中于本机测量音量峰值时使用麦克风。站内语音上传需另行确认并经过原音频安全检查，发送消息还需再次确认。声音互动玩法仅在本地测量振幅、不上传录音；结束后即停止使用麦克风，不会在后台运行。"
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step counts are read from this iPhone only when you view a walking activity. Step counts don't prove you walked and don't unlock rewards."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你主动查看步行活动时读取此 iPhone 的步数。步数不能证明实际行走，也不会解锁奖励。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a walk card, a medal card, or a city stamp slip picture to Photos when you choose Save to Photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你选择“保存到相册”时，将足迹卡、勋章卡或城市签小票图片添加到相册。"
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "comment": "Home-screen app name. Owner 2026-11-27: the English brand is Chein; Chinese stays 城瘾.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chein"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "城瘾"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Home-screen app name. Owner 2026-11-27: the English brand is Chein; Chinese stays 城瘾.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chein"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "城瘾"
          }
        }
      }
    }
  },
  "version": "1.0"
}
