{
  "sourceLanguage": "en",
  "strings": {
    "followList.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following and fans"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注与粉丝"
          }
        }
      }
    },
    "followList.following": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注"
          }
        }
      }
    },
    "followList.followers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fans"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粉丝"
          }
        }
      }
    },
    "followList.followed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You follow this member"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已关注此会员"
          }
        }
      }
    },
    "followList.notFollowed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not follow this member"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未关注此会员"
          }
        }
      }
    },
    "followList.notFriends": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following is not a two-way friendship. Open a profile to review a follow change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关注不等于双向好友。打开会员资料可预览关注变更。"
          }
        }
      }
    },
    "followList.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This list is not available for the current account yet. Go back and try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前账号的名单读取暂不可用，请返回后稍后重试。"
          }
        }
      }
    },
    "followList.emptyFollowing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No visible followed members."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可显示的关注会员。"
          }
        }
      }
    },
    "followList.emptyFollowers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No visible followers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可显示的粉丝。"
          }
        }
      }
    },
    "followList.mutualFollows": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutual follows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "互相关注"
          }
        }
      }
    }
  },
  "version": "1.0"
}
