{
  "sourceLanguage": "en",
  "strings": {
    "projectRunEndings.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run endings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行结局"
          }
        }
      }
    },
    "projectRunEndings.lead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the team's voted plan runs, the run closes on one of these endings. Story endings are written in the ending chapter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队伍表决的方案执行后，按这里的结局收场。剧情结局在结局章中编写。"
          }
        }
      }
    },
    "projectRunEndings.ending %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ending %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结局 %lld"
          }
        }
      }
    },
    "projectRunEndings.fallback.tag": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认收尾"
          }
        }
      }
    },
    "projectRunEndings.delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        }
      }
    },
    "projectRunEndings.delete.label %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete ending %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除结局 %lld"
          }
        }
      }
    },
    "projectRunEndings.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称"
          }
        }
      }
    },
    "projectRunEndings.name.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: Safe escape"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：成功撤离"
          }
        }
      }
    },
    "projectRunEndings.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ending details"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结局说明"
          }
        }
      }
    },
    "projectRunEndings.summary.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What players see as the result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "玩家看到的结果说明"
          }
        }
      }
    },
    "projectRunEndings.fallback": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set as default close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为默认收尾"
          }
        }
      }
    },
    "projectRunEndings.fallback.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When no plan passes, staff can close the run with it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有方案通过时，工作人员可用它收尾"
          }
        }
      }
    },
    "projectRunEndings.add": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add ending"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加结局"
          }
        }
      }
    },
    "projectRunEndings.open.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the run endings to fix this"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开运行结局进行修改"
          }
        }
      }
    },
    "projectRunEndings.issue.tooMany": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add up to 30 run endings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多添加 30 个运行结局"
          }
        }
      }
    },
    "projectRunEndings.issue.invalidID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An ending's ID is duplicated or invalid. Add that ending again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结局编号重复或无效，请重新添加该结局"
          }
        }
      }
    },
    "projectRunEndings.issue.fields": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter each ending's name (up to 80 characters) and description (up to 2,000 characters)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请填写结局名称（最多 80 字）和说明（最多 2000 字）"
          }
        }
      }
    },
    "projectRunEndings.issue.fallbackCount": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose exactly one default close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请指定且仅指定一个默认收尾结局"
          }
        }
      }
    },
    "projectRunEndings.issue.planEnding": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each voting plan must end on a saved ending of this theme"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表决方案须选择本主题已保存的结局章"
          }
        }
      }
    },
    "projectRunEndings.issue.inUse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A voting plan still uses this ending. Change that plan first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该结局正在被表决方案使用，请先修改对应方案"
          }
        }
      }
    }
  },
  "version": "1.0"
}
