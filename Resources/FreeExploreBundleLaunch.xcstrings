{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free-explore pass"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由探索权益"
          }
        }
      }
    },
    "stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is no longer current. Return and reopen from your account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前会话已失效，请返回后从本人账户重新进入。"
          }
        }
      }
    },
    "loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading current records…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取当前记录…"
          }
        }
      }
    },
    "error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load your pass. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权益加载失败，请重试"
          }
        }
      }
    },
    "unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original reservation result is not yet known. A new reservation is locked until it is recovered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约结果确认中"
          }
        }
      }
    },
    "recover": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新确认"
          }
        }
      }
    },
    "retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No bundle items returned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未返回套票项目。"
          }
        }
      }
    },
    "catalog": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle catalog"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "套票目录"
          }
        }
      }
    },
    "order": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报名记录"
          }
        }
      }
    },
    "choose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择"
          }
        }
      }
    },
    "unit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available entitlement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用权益"
          }
        }
      }
    },
    "offer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merchant offer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商家项目"
          }
        }
      }
    },
    "date": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约时间"
          }
        }
      }
    },
    "review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm reservation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认预约"
          }
        }
      }
    },
    "legacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This record has no bundle ledger. It remains read-only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这笔订单没有套票权益"
          }
        }
      }
    },
    "disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservation requires separately reviewed authorization and a current eligible record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约需要独立核实的授权与当前有效记录。"
          }
        }
      }
    },
    "confirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original result verified against the current order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原结果已与当前订单核实。"
          }
        }
      }
    },
    "notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the merchant and time before you confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请核对商家与时间后确认预约"
          }
        }
      }
    },
    "confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm reservation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认预约"
          }
        }
      }
    },
    "cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消复核"
          }
        }
      }
    },
    "paidAmount": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid amount"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实付金额"
          }
        }
      }
    },
    "saleUnknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale status hasn't arrived yet. It isn't shown as off sale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "售卖状态尚未读到，不按停售处理。"
          }
        }
      }
    },
    "reservationsEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reservations yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无预约记录"
          }
        }
      }
