        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm reservation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认预约"
          }
        }
      }
    },
    "legacy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This record has no bundle ledger. It remains read-only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这笔订单没有套票权益"
          }
        }
      }
    },
    "disabled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservation requires separately reviewed authorization and a current eligible record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约需要独立核实的授权与当前有效记录。"
