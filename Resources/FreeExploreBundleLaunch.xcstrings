    "catalog": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundle catalog"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "套票目录"
