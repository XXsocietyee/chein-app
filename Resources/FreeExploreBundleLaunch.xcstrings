      }
    },
    "confirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original result verified against the current order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原结果已与当前订单核实。"
          }
        }
