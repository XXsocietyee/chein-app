{
  "sourceLanguage": "en",
  "strings": {
    "title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free-explore pass"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由探索权益"
          }
        }
      }
    },
    "stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session is no longer current. Return and reopen from your account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前会话已失效，请返回后从本人账户重新进入。"
          }
        }
      }
    },
    "loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading current records…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在读取当前记录…"
          }
        }
      }
    },
    "error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load your pass. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权益加载失败，请重试"
          }
        }
      }
    },
    "unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original reservation result is not yet known. A new reservation is locked until it is recovered."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约结果确认中"
          }
        }
      }
    },
    "recover": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新确认"
          }
        }
      }
    },
    "retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No bundle items returned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未返回套票项目。"
          }
        }
