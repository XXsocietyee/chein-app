    "notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the merchant and time before you confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请核对商家与时间后确认预约"
          }
        }
      }
    },
    "confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm reservation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认预约"
          }
        }
      }
    },
    "cancel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消复核"
          }
        }
      }
    },
    "paidAmount": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paid amount"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实付金额"
          }
        }
      }
    },
    "saleUnknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale status hasn't arrived yet. It isn't shown as off sale."
