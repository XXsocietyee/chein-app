{
  "sourceLanguage": "en",
  "strings": {
    "reason.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stall can't be reserved right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该门店暂时无法预约。"
          }
        }
      }
    },
    "reason.ledgerOff": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookings temporarily unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约暂时不可用。"
          }
        }
      }
    },
    "reason.merchantExited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The merchant has left this program."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商家已退出该活动。"
          }
        }
      }
    },
    "reason.noBalance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have no available units left."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有可用的次数。"
          }
        }
      }
    },
    "reason.notYetValid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This offer is not valid yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该优惠尚未生效。"
          }
        }
      }
    },
    "reason.offerExpired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This offer has expired."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该优惠已过期。"
          }
        }
      }
    },
    "reason.outsideValidity": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chosen time is outside your validity period."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选时间不在有效期内。"
          }
        }
      }
    },
    "reason.reservationOff": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookings temporarily unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约暂时不可用。"
          }
        }
      }
    },
    "reason.reservedElsewhere": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This unit is already reserved elsewhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该次数已预约其他门店。"
          }
        }
      }
    },
    "reasons.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why it can't be reserved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不可预约的原因"
          }
        }
      }
    },
    "slots.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available times"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可预约时间"
          }
        }
      }
    },
    "unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stall is not available right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该门店暂时无法查看。"
          }
        }
      }
    },
    "window.choose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续"
          }
        }
      }
    },
    "window.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择时间"
          }
        }
      }
    },
    "window.none": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No selectable day within your validity period."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效期内没有可选日期。"
          }
        }
      }
    },
    "window.pick": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始时间"
          }
        }
      }
    }
  },
  "version": "1.0"
}
