        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有读取成功，请再试一次。"
          }
        }
