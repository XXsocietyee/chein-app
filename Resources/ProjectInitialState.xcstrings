      }
    },
    "projectInitialState.counterBound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting values come from the registered definitions. Change them in the theme settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初值由注册定义管理，请到主题配置调整"
          }
        }
      }
    },
    "projectInitialState.binding.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registered attributes in use"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用的注册属性"
          }
        }
      }
    },
    "projectInitialState.binding.notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the attributes you tick are used. Once you confirm, the registry definitions apply; games already under way don't change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只启用你勾选的属性。确认后定义以注册表为准，不改变已开始的局。"
          }
        }
      }
    },
    "projectInitialState.binding.notReady": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full registry version hasn't been read yet; your current setup stays as it is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整注册版本尚未读取；现有配置保持不变。"
          }
        }
      }
    },
    "projectInitialState.binding.saveFirst": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the topic draft first, then read the registered attributes."
