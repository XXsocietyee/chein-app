    "projectInitialState.counterInvalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The starting value is outside the current range. Change it before you tap Done."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开局值超出当前范围，请修改后完成"
          }
