{
  "sourceLanguage": "en",
  "strings": {
    "modInstallation.error.bindingsRecovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resources could not be verified again. Any previous choices remain for review, but preparing and installing are disabled until refresh succeeds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法重新确认资源。已有选择保留供核对，刷新成功前不能准备或安装。"
          }
        }
      }
    },
    "modInstallation.bindingsChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some selected resources changed or no longer match this anchor. Review the available resources and choose again. Nothing was installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分已选资源发生变化或不再匹配此锚点。请核对可用资源并重新选择，尚未执行安装。"
          }
        }
      }
    },
    "modInstallation.chooseAnchorFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an anchor POI before binding resources. Map resources must be in the same region."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择锚点地点，再绑定资源。地图资源必须位于同一区域。"
          }
        }
      }
    },
    "modInstallation.anchor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anchor POI"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锚点地点"
          }
        }
      }
    },
    "modInstallation.authorizedVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original licensed version"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始授权版本"
          }
        }
      }
    },
    "modInstallation.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回"
          }
        }
      }
    },
    "modInstallation.bindingHash": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frozen binding hash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冻结绑定哈希"
          }
        }
      }
    },
    "modInstallation.bindings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose real store resources"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择真实门店资源"
          }
        }
      }
    },
    "modInstallation.bindingsBoundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only server-verified resources belonging to your store are selectable. Every required placeholder and a real anchor POI must be selected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅可选择服务端验证属于本人门店的资源。必须选择真实锚点地点，并填齐全部必需占位。"
          }
        }
      }
    },
    "modInstallation.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A purchase is only a license. Installation creates a private native draft, not published or executable content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买仅获得授权。安装只创建原生私有草稿，不会发布，也不会变成可执行内容。"
          }
        }
      }
    },
    "modInstallation.cancelBoundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server will resolve this original request. Closing the screen is not cancellation, and cancellation does not revoke or refund the purchase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端将处理此原始请求。关闭页面不等于取消；取消安装也不会撤销授权或退款。"
          }
        }
      }
    },
    "modInstallation.cancelQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel this prepared request?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消此待安装请求？"
          }
        }
      }
    },
    "modInstallation.cancelRequest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel original installation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消原安装请求"
          }
        }
      }
    },
    "modInstallation.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择…"
          }
        }
      }
    },
    "modInstallation.confirmBoundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm this exact version, store, anchor and binding receipt. No purchase, publication, execution or review approval is implied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认此原始版本、门店、锚点和绑定回执。本操作不代表再次购买、发布、执行或审核通过。"
          }
        }
      }
    },
    "modInstallation.confirmInstall": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm and create private draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认并创建私有草稿"
          }
        }
      }
    },
    "modInstallation.contentHash": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frozen content hash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冻结内容哈希"
          }
        }
      }
    },
    "modInstallation.draft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Member-template draft ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会员模板草稿编号"
          }
        }
      }
    },
    "modInstallation.editDraft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit private draft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑私有草稿"
          }
        }
      }
    },
    "modInstallation.error.cancelUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellation couldn't be confirmed. Check the original request before trying another action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无法确认取消结果，请先查询原请求再继续。"
          }
        }
      }
    },
    "modInstallation.error.factsUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installation receipt is retained, but current fact confirmation is not verified. Read current facts to recover; edits require a new review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装回执已保留，但尚无法确认当前事实状态。请读取当前事实恢复；改稿后需重新阅读确认。"
          }
        }
      }
    },
    "modInstallation.error.history": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current receipt is saved, but installation history could not be refreshed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前回执已保存，但暂时无法刷新安装历史。"
          }
        }
      }
    },
    "modInstallation.error.installUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The install result is unknown. Check the original request to recover its authoritative result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装结果未知，请查询原请求以恢复服务端最终结果。"
          }
        }
      }
    },
    "modInstallation.error.options": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Store options could not be verified. No installation request was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法验证门店资源，未发送安装请求。"
          }
        }
      }
    },
    "modInstallation.error.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved original request must be recovered before another installation can begin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有原请求待恢复，完成恢复前不能开始另一次安装。"
          }
        }
      }
    },
    "modInstallation.error.prepareUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparation could not be confirmed. Only check the saved original request; do not create a replacement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无法确认准备结果。请仅查询已保存的原请求，不要创建替代请求。"
          }
        }
      }
    },
    "modInstallation.error.recoveryUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original request could not be verified. Its saved identity is retained; refresh to check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法确认原请求，已保留原始编号，请刷新重查。"
          }
        }
      }
    },
    "modInstallation.error.requestUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server has not confirmed the saved original request. Keep this request and refresh; no replacement will be created."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端尚未确认已保存的原请求。请保留此请求并刷新，不会另建替代请求。"
          }
        }
      }
    },
    "modInstallation.error.selection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose resources from the current verified store options."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择当前已验证门店下的资源。"
          }
        }
      }
    },
    "modInstallation.error.session": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account or approval changed. Reopen installation in the current session to recover safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号或权限已变更，请在当前会话重新进入安装以安全恢复。"
          }
        }
      }
    },
    "modInstallation.error.storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery record could not be safely stored or read. Installation is blocked until recovery storage is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法安全保存或读取恢复记录。恢复存储可用前，安装已锁定。"
          }
        }
      }
    },
    "modInstallation.facts.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This confirms only the merchant facts in this exact draft. Any content edit requires confirmation again. Theme/content review and W02 publication remain separate required steps. The licensed source cannot be resold in the public marketplace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只确认此版本草稿中的门店事实。修改内容后必须重新确认。主题内容审核与 W02 发布仍是独立必需步骤，授权源模板不得在公共广场转售。"
          }
        }
      }
    },
    "modInstallation.facts.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm facts for this draft hash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认此草稿哈希的事实"
          }
        }
      }
    },
    "modInstallation.facts.confirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Facts confirmed for this exact draft hash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此草稿哈希对应的事实已确认"
          }
        }
      }
    },
    "modInstallation.facts.currentContent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current draft title and full rules"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前草稿标题与完整规则"
          }
        }
      }
    },
    "modInstallation.facts.draftHash": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current draft content hash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前草稿内容哈希"
          }
        }
      }
    },
    "modInstallation.facts.readConfirmation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read the full title, rules and bindings and confirm the real merchant facts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已阅读完整标题、规则与绑定，并确认真实门店事实。"
          }
        }
      }
    },
    "modInstallation.facts.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read current facts / recover confirmation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取当前事实 / 恢复确认结果"
          }
        }
      }
    },
    "modInstallation.facts.required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read and confirm the current merchant facts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请阅读并确认当前门店事实"
          }
        }
      }
    },
    "modInstallation.facts.review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the current draft and bindings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读当前草稿与绑定"
          }
        }
      }
    },
    "modInstallation.facts.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merchant fact confirmation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门店事实确认"
          }
        }
      }
    },
    "modInstallation.facts.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fact confirmation may have reached the server. Read the current facts before another confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事实确认可能已送达服务端，请先读取当前事实再继续。"
          }
        }
      }
    },
    "modInstallation.gate.MERCHANT_FACT_CONFIRMATION": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
