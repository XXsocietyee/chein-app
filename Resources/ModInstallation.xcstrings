    "modInstallation.templateEdit.reviewBoundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存不会自动审核或发布。事实确认须对应最新完整快照；提交审核另需已批准的提审接口配置，仅创建原审核任务并保持未上架，后续仍遵循原审核与 W02。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving never approves or publishes. Fact confirmation must match the latest full snapshot. Review submission requires a separate approved review configuration, creates the original review task and stays unpublished; original review and W02 still apply."
          }
        }
      }
    },
    "modInstallation.templateEdit.fullSnapshot": {
