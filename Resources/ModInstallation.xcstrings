    "modInstallation.originalRecovery.noLocalRequest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No original request record was found on this device. This does not prove that no installation occurred on the server. You can still read your original installation history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机没有可读取的原请求记录；不据此认定服务端从未安装。可继续读取本人原安装历史。"
          }
        }
      }
    },
    "modInstallation.originalRecovery.storageUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original local request journal is unavailable. Its records haven't been cleared or replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机原请求记录暂不可读；未清理或替换原记录。"
          }
        }
      }
    },
    "modInstallation.originalRecovery.requestUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This read didn't confirm the original request’s result (UNKNOWN). A 404, failure or timeout doesn't authorize a new install request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原请求本次结果 UNKNOWN。404、失败或超时均不授权新建安装请求。"
          }
        }
      }
    },
    "modInstallation.originalRecovery.resultSection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original request result from this read"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次明确读取的原请求结果"
          }
        }
      }
    },
    "modInstallation.originalRecovery.resultBoundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the original installation request state, not proof of uninstalling, publishing or successful execution. Existing drafts and runs are not overwritten by an update."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处是原安装请求状态，不是卸载、发布或运行成功证明；旧稿和旧 run 不被更新覆盖。"
          }
        }
      }
    },
    "modInstallation.originalRecovery.historySection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your original server installation history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端本人原安装历史"
          }
        }
      }
    },
    "modInstallation.originalRecovery.readRequest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read this exact original request"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确读取这一原请求"
          }
        }
      }
    },
    "modInstallation.originalRecovery.emptyHistory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This original history page is empty. That does not prove an uninstall or rule out earlier records."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次原历史页为空；不证明安装被卸载或不存在更早记录。"
          }
        }
      }
    },
    "modInstallation.originalRecovery.historyUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original history or selected request could not be confirmed in this read. An empty list or historical row is not a completed result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原历史或所选原请求本次读取未确认；不会从空列表或历史行制造完成结果。"
          }
        }
      }
    },
    "modInstallation.originalRecovery.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the same original request and history"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新同一原请求与原历史"
          }
        }
      }
    }
  },
  "version": "1.0"
}
