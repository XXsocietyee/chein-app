    "modInstallation.graph.topicBoundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every node, option, edge and fallback is preserved in the native topic draft. Existing host authoring policies apply, including XP configuration. No reward is granted and nothing is published by installation. Review the full saved facts before submitting through the original content review and W02 release flow."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有节点、选项、边与回退均保存到原生主题草稿。沿用现有主机创作规则，包括 XP 配置；安装不发奖、不发布。保存后请回读全部事实，再走原内容审核及 W02 发布流程。"
          }
        }
      }
    },
    "modInstallation.graph.qaBoundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本答题 · 单语言 · 导入 XP 为 0。后续编辑仍须通过原事实确认、审核和发布。答题次数耗尽在既有原生流程表示“答完”，不等于“答对”；后继仅按服务器完成回执推进。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text questions · One language · Imported XP is 0. Edits still require fact confirmation, review and publication. In the existing native flow, exhausted attempts mean finished, not correct. Only the server completion receipt advances the route."
          }
        }
      }
    },
