          "stringUnit": {
            "state": "translated",
            "value": "Original license and results"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原许可与原结果"
          }
        }
      }
    },
    "modInstallation.originalRecovery.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only reads the original request and installation history. It does not load new installation options, resubmit prepare/install/cancel, or edit or run installed content. Revocation or delisting does not mean the original request never happened; an old receipt does not restore installation or runtime rights."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只读原请求与原安装历史，不读取新安装选项、不重发 prepare/install/cancel，不编辑或执行安装内容。撤权和下架不等于原请求未发生；旧回执也不恢复安装或运行权利。"
          }
        }
      }
    },
    "modInstallation.originalRecovery.localSection": {
      "extractionState": "manual",
      "localizations": {
