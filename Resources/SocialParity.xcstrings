    "drafts.emptyDetail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写到一半退出时会自动存成草稿，回到这里就能接着写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you leave halfway, your post is saved as a draft. Come back here to keep writing."
          }
        }
      }
    },
    "drafts.count %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 %lld 条草稿"
