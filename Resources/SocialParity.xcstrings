{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "share.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转发帖文"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share post"
          }
        }
      }
    },
    "share.close": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        }
      }
    },
    "share.genericNote": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条帖文不是公开帖，转发卡片只带「城瘾Hub」，不带正文和图片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This post isn't public, so the card only shows Chengyin Hub — no text or images."
          }
        }
      }
    },
