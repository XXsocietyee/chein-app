  "strings": {
    "appeal.state.ACCEPTED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appeal upheld. Check the latest review status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申诉已成立，请查看最新审核状态"
          }
        }
      }
    },
    "appeal.state.REJECTED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appeal not upheld; the original decision stands"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申诉未成立，维持原处理"
          }
        }
      }
    },
    "appeal.state.REVIEWING": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appeal in review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申诉处理中"
          }
        }
      }
    },
    "appeal.state.SUBMITTED": {
      "extractionState": "manual",
