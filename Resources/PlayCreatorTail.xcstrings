    "audit.note.confirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original appeal is confirmed. Appeal number %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原申诉及附件意图已确认，申诉编号 %@"
          }
        }
      }
    },
    "audit.note.legacyUnbound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An earlier appeal is not bound to its original request number. Check the platform review record below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史申诉未绑定原请求号，保留说明；请核对下方平台审核记录。"
          }
        }
      }
    },
    "audit.note.networkPending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network problem: the original appeal result is pending. Read the appeal record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络异常，原申诉结果待确认，请读取申诉记录"
          }
        }
      }
    },
    "audit.note.pendingOnOpen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original appeal result is pending. Read the platform record; do not change the original text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原申诉结果待确认，请读取平台记录；不要修改原说明。"
          }
        }
      }
    },
    "audit.note.readFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result could not be read. The original number and text are kept; try reading again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果读取失败，保留原号和冻结输入，请重试读取。"
          }
        }
      }
    },
    "audit.note.recordIncomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original appeal record is incomplete, so it cannot be confirmed or resubmitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原申诉记录不完整，不能确认或重新提交。"
          }
        }
      }
    },
    "audit.note.storageFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The appeal draft could not be saved. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申诉草稿保存失败，请重试"
          }
        }
      }
    },
    "audit.note.submitted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appeal submitted, checking the result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申诉已提交，正在核对结果"
          }
        }
      }
    },
    "audit.note.unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original appeal result is not confirmed. The original number and text are kept; not found does not mean not submitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原申诉结果未确认，保留原号和冻结输入；查无不代表未提交。"
          }
        }
      }
    },
