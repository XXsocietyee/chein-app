{
  "sourceLanguage": "en",
  "strings": {
    "playReview.refusal.advancedRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish this stop's special gameplay first, then submit your answer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成本站的「特殊玩法」，再提交答案。"
          }
        }
      }
    },
    "playReview.refusal.arrivalRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check in at this stop first, then submit your answer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先到达本站完成打卡，再提交答案。"
          }
        }
      }
    },
    "playReview.refusal.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still working on the last action. Try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理上一次操作，请稍后再提交。"
          }
        }
      }
    },
    "playReview.refusal.completed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stop is already complete. There is nothing to submit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本站已完成，无需再次提交。"
          }
        }
      }
    },
    "playReview.refusal.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submitting isn't available right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交功能暂不可用。"
          }
        }
      }
    },
    "playReview.refusal.emptyAnswer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an answer first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先填写答案。"
          }
        }
      }
    },
    "playReview.refusal.invalidChoice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose one of the options."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一个选项。"
          }
        }
      }
    },
    "playReview.refusal.invalidEvidence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your submission is incomplete. Check it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交内容不完整，请检查后重试。"
          }
        }
      }
    },
    "playReview.refusal.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stop is still locked. Finish the stop before it first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本站尚未解锁，请先完成前一站。"
          }
        }
      }
    },
    "playReview.refusal.notVisible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task is no longer available. Go back and refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个任务已不可用，请返回后刷新。"
          }
        }
      }
    },
    "playReview.refusal.sessionChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account or run changed. Open this journey again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号或本局已变化，请重新进入旅程。"
          }
        }
      }
    },
    "playReview.refusal.sessionUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This run can't take submissions right now. Refresh and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本局当前无法提交，请刷新后再试。"
          }
        }
      }
    },
    "playReview.refusal.unresolved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last submission isn't confirmed yet. Check your progress first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次提交的结果尚未确认，请先核对当前进度。"
          }
        }
      }
    },
    "playReview.refusal.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task can't be submitted here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个任务暂不支持在这里提交。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
