{
  "sourceLanguage": "en",
  "strings": {
    "afterSalesPointer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a merchant failed to deliver, please go to After-sales to follow up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如商家未履约，请前往售后处理。"
          }
        }
      }
    },
    "amountLabel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Amount"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额"
          }
        }
      }
    },
    "quoteOnlyNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a quote only — no money moves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅为预估，不会产生任何资金变动。"
          }
        }
      }
    },
    "remainingRatioLabel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remaining ratio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余比例"
          }
        }
      }
    },
    "remainingValueLabel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remaining value"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余价值"
          }
        }
      }
    },
    "routeNotRefundableBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on the current status, this order is not refundable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按当前状态，该订单不可退款。"
          }
        }
      }
    },
    "routeNotRefundableTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not refundable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不可退款"
          }
        }
      }
    },
    "routeOriginalBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on the current status, the refund would go back to your original payment method."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按当前状态，退款将原路退回。"
          }
        }
      }
    },
    "routeOriginalTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refund to original payment method"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原路退回"
          }
        }
      }
    },
    "routePlatformBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on the current status, the refund would go to your platform balance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按当前状态，退款将退回平台余额。"
          }
        }
      }
    },
    "routePlatformTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refund to platform balance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退回平台余额"
          }
        }
      }
    },
    "routeUnknownBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We can't show a result for this quote in this version. Please contact support."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本无法展示该预估结果，请联系客服。"
          }
        }
      }
    },
    "routeUnknownTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please contact support"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请联系客服"
          }
        }
      }
    },
    "title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refund quote"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退款预估"
          }
        }
      }
    },
    "totalValueLabel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total value"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总价值"
          }
        }
      }
    }
  },
  "version": "1.0"
}
