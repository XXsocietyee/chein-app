    "nativeAttribute.mixedBatch": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次同时编辑了原注册键和完整属性；当前合同不能把它们作为一笔保存。已保留全部本地稿，不会自动拆成多笔请求。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This edit mixes legacy registrations and full definitions. The contract cannot save them atomically. All local edits remain retained; no split requests are sent."
          }
        }
      }
    },
    "nativeAttribute.versionedSaveNotice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整属性保存前由项目校验，确认响应后读取完整定义和新版本。旧版本编辑器将退役，请重新进入项目。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project validates full definitions before saving. The acknowledgement must include complete definitions and a new version. Reopen the project after the old editor retires."
          }
        }
      }
    },
