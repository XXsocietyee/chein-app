          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current registration API cannot save extended attribute configuration. It remains in the local draft and was not submitted."
          }
        }
      }
    },
    "nativeAttribute.historicalRecovery": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留此前扩展配置的未知请求。当前注册接口不能证明扩展配置已保存；请继续原结果核验流程。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The earlier extended-configuration request is retained. The current registration API cannot prove its extensions were saved. Continue original result verification."
          }
        }
      }
    },
    "nativeAttribute.localRegistrationCheck": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只核对注册字段格式；服务端仍会检查归属、编辑窗口和名称内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only registration field format is checked here. The server still checks ownership, edit window and label content."
          }
        }
      }
    },
    "nativeAttribute.serverReferenceCheck": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认后服务端会先读取真实引用；有引用、解析失败或引用来源不完整时拒绝删除。没有单独的客户端“无引用”证明。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On confirmation the server reads actual references first. References, parse failure or incomplete sources prevent deletion. No separate client no-reference proof is claimed."
          }
        }
      }
    },
