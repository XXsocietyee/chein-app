    "nativeAttribute.referenceClear": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次权威读取未发现引用。删除时服务端还会检查。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This authoritative read found no references. The server checks again during deletion."
          }
        }
      }
    },
    "nativeAttribute.review": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认修改"
          }
