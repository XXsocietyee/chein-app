          "stringUnit": {
            "state": "translated",
            "value": "本次已保存项目检查未返回问题；这不表示属性已保存或允许删除、发布。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved-project check returned no issues. It does not confirm an attribute save or authorize deletion or publication."
          }
        }
      }
    },
    "nativeAttribute.savedSourceCheck": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查使用服务端已保存项目，不校验尚未提交的本地属性稿。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks use the saved server project and do not validate unsent local attribute edits."
          }
        }
      }
    },
    "nativeAttribute.originalReportNeeded": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完整保留原项目预检查响应。原项目报告视图接入后可查看；此响应不表示保存或发布成功。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original preflight response is retained in full. Its original project report view is required for display. This response does not confirm a save or publication."
          }
        }
      }
    },
    "nativeAttribute.registrationScopeNotice": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
