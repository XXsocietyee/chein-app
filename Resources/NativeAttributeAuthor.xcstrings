            "value": "Review changes"
          }
        }
      }
    },
    "nativeAttribute.saveReview": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将提交基础注册字段；服务端确认后还会回读核对。扩展配置不会被丢弃后混作注册成功。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit basic registration fields and verify authoritative readback after acknowledgement. Extended configuration is never silently dropped and reported as saved."
          }
        }
      }
    },
    "nativeAttribute.deleteReview": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将请求服务端先检查引用，只有原检查成功且无引用时才删除。拒绝原因会原样展示。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the server to check references first and delete only after its successful empty result. Its rejection reason is displayed unchanged."
          }
        }
      }
    },
    "nativeAttribute.confirm": {
      "extractionState": "manual",
