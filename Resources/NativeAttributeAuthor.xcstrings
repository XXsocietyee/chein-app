    "nativeAttribute.extensionLocalOnly": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "范围、显示、排序、持久范围和事件规则目前仅保存在本地稿。当前项目接口尚不能保存这些扩展配置。"
