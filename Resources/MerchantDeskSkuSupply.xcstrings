{
  "sourceLanguage": "en",
  "strings": {
    "merchant.desk.sku.originalPriceOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit existing SKU supply only. Displayed prices are reference values; saving preserves the current server prices and does not list or sell the product."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅编辑既有 SKU 供给。所示价格仅供参考，保存保留服务端当前价格，不上架或售卖商品。"
          }
        }
      }
    },
    "merchant.desk.review.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Product review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商品版本审核"
          }
        }
      }
    },
    "merchant.desk.review.boundary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submission is not approval or publication. Only the original platform reviewer can decide; unconfirmed qualifications remain unconfirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交不等于批准或上架。仅原平台有权审核者可决定，专项资质未确认时保持未确认。"
          }
        }
      }
    },
    "merchant.desk.review.recover": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read original entry result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回读原提交结果"
          }
        }
      }
    },
    "merchant.desk.review.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result is unconfirmed. Keep the original request and read it again; do not resubmit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果未确认，请保留原请求回读，不重复提交。"
          }
        }
      }
    },
    "merchant.desk.review.submitted %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original submission accepted at revision %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原提交已受理，版本 %lld"
          }
        }
      }
    },
    "merchant.desk.review.version %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current revision %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本 %lld"
          }
        }
      }
    },
    "merchant.desk.review.submit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit this product revision"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交当前商品版本审核"
          }
        }
      }
    },
    "merchant.desk.review.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read current review result"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回读当前审核结果"
          }
        }
      }
    },
    "merchant.desk.review.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit the current saved product and SKU version for review? This does not publish it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交当前已保存商品与 SKU 版本审核？此操作不上架。"
          }
        }
      }
    },
    "merchant.desk.review.state.UNVERIFIED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review source not yet confirmed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审核来源尚未确认"
          }
        }
      }
    },
    "merchant.desk.review.state.DRAFT": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft / revised"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿／已修订"
          }
        }
      }
    },
    "merchant.desk.review.state.PENDING_REVIEW": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for platform review"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待平台审核"
          }
        }
      }
    },
    "merchant.desk.review.state.APPROVED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original current revision approved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原当前版本审核通过"
          }
        }
      }
    },
    "merchant.desk.review.state.REJECTED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejected; read the original reason"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已驳回，请查看原原因"
          }
        }
      }
    },
    "merchant.desk.review.state.OFF_SHELF": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off shelf"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下架"
          }
        }
      }
    },
    "merchant.desk.review.legacy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原目录状态未验证；新版本审核尚未启用，不据此称已批准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original catalog status is unverified. Review of the new revision is not yet enabled; this does not indicate approval."
          }
        }
      }
    },
    "merchant.desk.review.qualification.ready": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原资格当前已确认；不替代商品版本审核。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original qualification is currently confirmed. This does not replace review of the product revision."
          }
        }
      }
    },
    "merchant.desk.review.qualification.unknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原资格未确认或已失效；不能据历史审核称当前可公开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original qualification is unconfirmed or no longer valid. A past approval does not establish current eligibility for publication."
          }
        }
      }
    },
    "merchant.desk.review.public.available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务端确认当前商品与资格同版本可公开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server confirms that publication is allowed for the current product revision and its associated qualification revision."
          }
        }
      }
    },
    "merchant.desk.review.public.unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前不能确认同版本公开有效；历史提交回执仍保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publication eligibility for the current product and qualification revisions cannot be confirmed. Past submission receipts are retained."
          }
        }
      }
    },
    "merchant.desk.anchor.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门店核销锚点配置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Store redemption anchor settings"
          }
        }
      }
    },
    "merchant.desk.anchor.boundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅配置地图锚点，不验证到店、不启用核销或发奖。门店坐标仅供定位，须人工点选并确认。保留原 WiFi 配置，不扫描设备。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure the map anchor only. This doesn't verify a store visit, enable redeem, or issue rewards. Store coords are for locating the store only; manually select and confirm the anchor. Existing Wi-Fi settings are preserved; no devices scanned."
          }
        }
      }
    },
    "merchant.desk.anchor.recover": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回读原锚点保存请求"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the original anchor save request"
          }
        }
      }
    },
    "merchant.desk.anchor.unknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果未确认，保留原请求；不自动重发。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is unconfirmed. Keep the original request; it won't be resent own."
          }
        }
      }
    },
    "merchant.desk.anchor.accepted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原保存请求已受理；当前配置另行回读，不代表核销资格。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save accepted. Not a redeem right."
          }
        }
      }
    },
    "merchant.desk.anchor.version %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置版本 %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current settings revision %lld"
          }
        }
      }
    },
    "merchant.desk.anchor.wifi %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留原 WiFi 配置数 %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing Wi-Fi entries preserved: %lld"
          }
        }
      }
    },
    "merchant.desk.anchor.store": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原门店位置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original store location"
          }
        }
      }
    },
    "merchant.desk.anchor.saved": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前保存锚点"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currently saved anchor"
          }
        }
      }
    },
    "merchant.desk.anchor.selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人工选定锚点"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manually selected anchor"
          }
        }
      }
    },
    "merchant.desk.anchor.radius %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锚点半径 %lld 米"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anchor radius: %lld meters"
          }
        }
      }
    },
    "merchant.desk.anchor.attest": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已核对真实门店并明确确认此人工选点，不将地图反查当到店证据"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have checked the actual store and explicitly confirm this manually selected location. I will not treat a map lookup as proof of a store visit."
          }
        }
      }
    },
    "merchant.desk.anchor.save": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认保存原锚点配置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm and save the original anchor settings"
          }
        }
      }
    },
    "merchant.desk.anchor.missingStore": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原门店位置缺失，先通过原门店资料入口补齐；不生成或代填坐标。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original store location is missing. Add it through the original store details entry first; coords won't be generated or filled."
          }
        }
      }
    },
    "merchant.desk.anchor.refresh": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新原配置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the original settings"
          }
        }
      }
    },
    "merchant.desk.anchor.confirm": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存人工选择的位置及半径，保留既有 WiFi。此操作不执行核销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the manually selected location and radius, preserving existing Wi-Fi settings. This does not perform redemption."
          }
        }
      }
    },
    "merchant.evidence.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核销复核与补充说明"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redemption review and additional info"
          }
        }
      }
    },
    "merchant.evidence.boundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅向原待复核单补充说明或已确认的本单私密图片，不执行核销、发奖或改变裁决。图片上传与原补证提交是两次明确确认。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only add info or confirmed private images for this case to the original pending review. This doesn't perform redeem, issue rewards, or change the decision. Image upload and entry of extra evidence each require separate explicit confirmation."
          }
        }
      }
    },
    "merchant.evidence.unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原复核入口或权限未配置"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review access isn't set."
          }
        }
      }
    },
    "merchant.evidence.recover": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回读原补证请求"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check original extra-evidence"
          }
        }
      }
    },
    "merchant.evidence.unknown": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补证结果未确认，保留原请求，不自动重发。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The extra-evidence result is unconfirmed. Keep the original request; won't resent own."
          }
        }
      }
    },
    "merchant.evidence.accepted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原补证已受理；下方是原单当前裁决，不代表补证已获认可。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidence accepted, not approved."
          }
        }
      }
    },
    "merchant.evidence.review %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原复核单 %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original review case %lld"
          }
        }
      }
    },
    "merchant.evidence.originalAttachments": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原单已有附件记录。仅对本单私密图片逐请求授权读取，不猜测其他旧附件地址。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original case has attachment records. Access to private images for case requires approval each request; other existing attachment addresses won't guessed."
          }
        }
      }
    },
    "merchant.evidence.noteLimit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明最多 500 字符。不要填密码、核销凭据或无关个人资料。仅本次提交，离页不保留正文。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 500 characters. Do not include passwords, redeem credentials, or unrelated personal info. The note is used only for this submission and isn't retained when you leave the page."
          }
        }
      }
    },
    "merchant.evidence.submit": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认补充原复核说明"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm extra info for original review"
          }
        }
      }
    },
    "merchant.evidence.refresh": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新原单当前裁决"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the current decision on the original case"
          }
        }
      }
    },
    "merchant.evidence.list": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新我的原复核单"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh my original review cases"
          }
        }
      }
    },
    "merchant.evidence.confirm": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将本次说明提交到所选原待复核单；不会改变裁决或执行核销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit this note to the selected original pending review case. This will not change the decision or perform redemption."
          }
        }
      }
    },
    "merchant.evidence.image.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本单私密图片补证"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private image evidence for this case"
          }
        }
      }
    },
    "merchant.evidence.image.boundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只选择你有权提供的本复核单图片。经明确同意上传到原私密证据域，随后仍需确认提交补证；上传不是裁决或核销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select only images for this review case that you've right provide. Explicit consent, will uploaded original private evidence storage. Must separately confirm extra-evidence entry. Uploading doesn't decide case perform redeem."
          }
        }
      }
    },
    "merchant.evidence.image.choose": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择本单真实图片"
          }
        },
        "en": {
