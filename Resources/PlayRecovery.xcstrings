{
  "sourceLanguage": "en",
  "strings": {
    "arrival.action.appeal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can appeal this check from the stop's guard record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以从这一站的核验记录发起申诉。"
          }
        }
      }
    },
    "arrival.action.contact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact the organizer of this run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请联系本场组织者。"
          }
        }
      }
    },
    "arrival.action.leader": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask your team leader to release the chapter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请队长放行本章。"
          }
        }
      }
    },
    "arrival.action.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the route"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新路线"
          }
        }
      }
    },
    "arrival.action.relocate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locate again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新定位"
          }
        }
      }
    },
    "arrival.action.scan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the stop's code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫这一站的码"
          }
        }
      }
    },
    "arrival.action.scanHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this stop has a code on site, you can scan it instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果现场有这一站的码，也可以扫码。"
          }
        }
      }
    },
    "arrival.next.ARRIVE_ACCURACY_INVALID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locate again. This is not a cheating verdict."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新定位。这不是作弊判定。"
          }
        }
      }
    },
    "arrival.next.ARRIVE_ACCURACY_LOW": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move into the open and locate again. A weak signal does not widen the stop's area."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请到开阔处重新定位。信号差不会放宽这一站的范围。"
          }
        }
      }
    },
    "arrival.next.ARRIVE_ACCURACY_MISSING": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locate again so the reading includes its accuracy. This is not a cheating verdict."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新定位，让读数带上精度。这不是作弊判定。"
          }
        }
      }
    },
    "arrival.next.ARRIVE_COORD_NOT_CONFIGURED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trying again will not help. The organizer needs to fix this stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试不会成功，需要组织者修正这一站。"
          }
        }
      }
    },
    "arrival.next.ARRIVE_GUARD_SPEED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending again would be refused the same way. Check this on the stop again on site."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次发送也会被同样拒绝，请在现场重新核验。"
          }
        }
      }
    },
    "arrival.next.ARRIVE_GUARD_THROTTLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait a moment, then locate again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍等片刻再重新定位。"
          }
        }
      }
    },
    "arrival.next.ARRIVE_GUARD_WINDOW_DISTANCE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending again would be refused the same way. Check this on the stop again on site."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次发送也会被同样拒绝，请在现场重新核验。"
          }
        }
      }
    },
    "arrival.next.ARRIVE_LOCATION_INVALID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locate again and send the new reading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新定位后再提交新的读数。"
          }
        }
      }
    },
    "arrival.next.ARRIVE_LOCATION_MISSING": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location for Chein, then locate again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许城瘾使用定位，然后重新定位。"
          }
        }
      }
    },
    "arrival.next.ARRIVE_LOCATION_STALE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locate again to send a fresh reading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新定位，提交新的读数。"
          }
        }
      }
    },
    "arrival.next.ARRIVE_NOT_RECORDED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your arrival here before answering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先记录到达这一站，再作答。"
          }
        }
      }
    },
    "arrival.next.ARRIVE_TOO_FAR": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk closer to the stop, then locate again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请走近这一站后重新定位。"
          }
        }
      }
    },
    "arrival.next.NODE_DELISTED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It cannot be completed now. Stops you already finished stay in your history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在无法完成。已完成的站点仍保留在记录中。"
          }
        }
      }
    },
    "arrival.next.OTHER": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was recorded for this try."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次尝试没有被记录。"
          }
        }
      }
    },
    "arrival.next.ROUTE_LOCKED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh to see which stop comes first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请刷新，查看应先去哪一站。"
          }
        }
      }
    },
    "arrival.next.STORE_SCAN_REQUIRED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location cannot replace the merchant's scan here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里不能用定位代替商家扫码。"
          }
        }
      }
    },
    "arrival.next.TASK_REQUIRED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrival alone does not complete this stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅到达不能完成这一站。"
          }
        }
      }
    },
    "arrival.next.TEAM_LEAD_REQUIRED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The leader releases this chapter before anyone can continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队长放行本章后才能继续。"
          }
        }
      }
    },
    "arrival.reading.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this stop"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达这一站"
          }
        }
      }
    },
    "arrival.reason.ARRIVE_ACCURACY_INVALID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location accuracy was invalid"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位精度无效"
          }
        }
      }
    },
    "arrival.reason.ARRIVE_ACCURACY_LOW": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is not precise enough"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位精度不足"
          }
        }
      }
    },
    "arrival.reason.ARRIVE_ACCURACY_MISSING": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location accuracy was missing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少定位精度"
          }
        }
      }
    },
    "arrival.reason.ARRIVE_COORD_NOT_CONFIGURED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stop has no location set"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一站没有设置位置"
          }
        }
      }
    },
    "arrival.reason.ARRIVE_GUARD_SPEED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This move looked too fast to verify"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次移动过快，无法核验"
          }
        }
      }
    },
    "arrival.reason.ARRIVE_GUARD_THROTTLE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many tries in a short time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短时间内尝试过多"
          }
        }
      }
    },
    "arrival.reason.ARRIVE_GUARD_WINDOW_DISTANCE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This position change could not be verified"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次位置变化无法核验"
          }
        }
      }
    },
    "arrival.reason.ARRIVE_LOCATION_INVALID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The location could not be used"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位无效"
          }
        }
      }
    },
    "arrival.reason.ARRIVE_LOCATION_MISSING": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No location reached the server"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器没有收到定位"
          }
        }
      }
    },
    "arrival.reason.ARRIVE_LOCATION_STALE": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The location reading was too old"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定位时间已过期"
          }
        }
      }
    },
    "arrival.reason.ARRIVE_NOT_RECORDED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrive at this stop first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先到达这一站"
          }
        }
      }
    },
    "arrival.reason.ARRIVE_TOO_FAR": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not at this stop yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没到这一站附近"
          }
        }
      }
    },
    "arrival.reason.NODE_DELISTED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stop is closed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一站已关闭"
          }
        }
      }
    },
    "arrival.reason.OTHER": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not record this arrival"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器没有记录这次到达"
          }
        }
      }
    },
    "arrival.reason.ROUTE_LOCKED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stop is not unlocked yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一站尚未解锁"
          }
        }
      }
    },
    "arrival.reason.STORE_SCAN_REQUIRED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stop needs the in-store code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一站需要扫店内的码"
          }
        }
      }
    },
    "arrival.reason.TASK_REQUIRED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish this stop's task first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成这一站的任务"
          }
        }
      }
    },
    "arrival.reason.TEAM_LEAD_REQUIRED": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the team leader"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待队长放行"
          }
        }
      }
    },
    "arrival.replacement.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The organizer approved going to this stop instead. You still need to arrive there."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组织者已批准改去这一站，仍需真实到达那里。"
          }
        }
      }
    },
    "arrival.replacement.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No replacement has been approved. This stop cannot be skipped and no reward is given for it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未批准替代站。这一站不能跳过，也不会发放奖励。"
          }
        }
      }
    },
    "arrival.replacement.open %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to %@ instead"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改去「%@」"
          }
        }
      }
    },
    "arrival.replacement.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approved replacement"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已批准的替代站"
          }
        }
      }
    },
    "arrival.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrival not recorded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "到达未记录"
          }
        }
      }
    },
    "location.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off for Chein, so no arrival was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "城瘾的定位权限已关闭，未发送到达。"
          }
        }
      }
    },
    "location.openSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        }
      }
    },
    "location.unusable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This location reading could not be used and was not sent. Locate again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次定位读数不可用，未发送。请重新定位。"
          }
        }
      }
    },
    "pack.alwaysOnline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers, arrivals, hints, rewards, payments and scores always need a connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作答、到达、提示、奖励、支付和成绩始终需要联网。"
          }
        }
      }
    },
    "pack.asset.download": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载"
          }
        }
      }
    },
    "pack.asset.downloading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading"
          }
