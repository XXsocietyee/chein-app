    },
    "nativeCondition.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "nativeCondition.epochWindow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter Unix epoch milliseconds. The start is inclusive and the end is exclusive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 Unix 毫秒时间戳，包含开始时间，不包含结束时间。"
          }
        }
      }
    },
    "nativeCondition.topicMedalOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a medal from this topic. The effect scope is TOPIC_MEDAL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅选择原主题目录中的收藏勋章，作用域为 TOPIC_MEDAL。"
          }
        }
      }
    },
    "nativeCondition.fieldFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the field values and reopen the form if the draft changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请核对字段值；草稿发生变更时重新打开表单。"
