{
  "sourceLanguage": "en",
  "strings": {
    "nativeCondition.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions and effects"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条件与效果"
          }
        }
      }
    },
    "nativeCondition.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This editor is no longer current. Reopen it from the original draft."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此编辑页已失效，请从原草稿重新打开。"
          }
        }
      }
    },
    "nativeCondition.readOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original syntax is preserved for review. Editing requires a compatible author contract."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留原语法供查看；编辑需要兼容的作者合同。"
          }
        }
      }
    },
    "nativeCondition.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
