    "nativeCondition.op.EMIT_EVENT": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trigger CUSTOM attribute rules"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发 CUSTOM 属性规则"
          }
        }
      }
    },
    "nativeCondition.customEventOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original personal node or check outcome only. Executes the frozen CUSTOM rules in this action; no event payload, external recipient or timer. Shared owners are not supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限原个人节点或检定结果，在同一动作内执行冻结的 CUSTOM 属性规则。无载荷、外部收件人或定时触发；暂不支持共享主体。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
