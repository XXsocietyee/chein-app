    "nativeCondition.changeOperationDetail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fields and nested content for this operation will be replaced. Unknown extensions are retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将替换此操作的已知字段和嵌套内容，保留未知扩展字段。"
          }
        }
      }
    },
