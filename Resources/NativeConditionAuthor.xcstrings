    "nativeCondition.originalReadbackDeferred": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The attribute source changed. The original project could not safely save its current draft before re-reading. The draft and original request journals were not replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "属性来源已改变。原项目未能先安全保存当前草稿，因此尚未重新读取；草稿和原请求账均未被替换。"
          }
        }
      }
    },
    "nativeCondition.readOriginalProject": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read original project again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取原项目"
          }
        }
      }
