        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration preview. This does not run the route or settle rewards."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置声明预览；不会执行路线或结算奖励。"
