    "nativeCondition.saveFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original draft was not confirmed saved. Check the configuration and retry from the current editor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未确认原草稿保存成功；请核对配置后在当前编辑页重试。"
