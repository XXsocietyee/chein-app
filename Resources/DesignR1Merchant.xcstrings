    "r1merchant.signing.after": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When signing is done, pull down here to see the new status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签约完成后，回到这里下拉刷新即可看到新状态。"
          }
        }
      }
    },
    "r1merchant.signing.line": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The payment provider's signing page only opens inside WeChat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收款服务商的签约页面只能在微信里打开。"
          }
        }
      }
    },
    "r1merchant.signing.openWeChat": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open WeChat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开微信"
          }
        }
      }
    },
    "r1merchant.signing.step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the signing link below"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制下方的签约链接"
          }
        }
      }
    },
    "r1merchant.signing.step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open WeChat, paste it into any chat and tap it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开微信，把链接发到任意聊天并点开"
          }
        }
      }
    },
    "r1merchant.signing.step3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the page to finish signing"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按页面提示完成签约"
          }
        }
      }
    },
