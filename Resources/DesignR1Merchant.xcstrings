    "r1merchant.withdraw.after": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support replies within 1 working day."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "客服 1 个工作日内回复。"
          }
        }
      }
    },
    "r1merchant.withdraw.line": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app does not pay out by itself. Support checks the amount and pays it to your verified account."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 不会直接打款。客服核对金额后，打到你已核验的收款账户。"
          }
        }
      }
    },
    "r1merchant.withdraw.step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the button below to contact support"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点下方按钮联系客服"
          }
        }
      }
    },
    "r1merchant.withdraw.step2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send your shop name and the amount to withdraw"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送店铺名称和要提现的金额"
          }
        }
      }
    },
    "r1merchant.withdraw.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdrawals are handled by platform support"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提现由平台客服办理"
          }
        }
      }
