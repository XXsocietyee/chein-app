      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing happens in WeChat"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签约在微信中完成"
          }
        }
