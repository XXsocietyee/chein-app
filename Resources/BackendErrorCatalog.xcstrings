{
  "sourceLanguage": "en",
  "strings": {
    "backendError.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题，请重试。"
          }
        }
      }
    },
    "backendError.status.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Please sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已过期，请重新登录。"
          }
        }
      }
    },
    "backendError.status.400": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request was not accepted. Check it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求未被接受，请检查后再试。"
          }
        }
      }
    },
    "backendError.status.401": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Please sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已过期，请重新登录。"
          }
        }
      }
    },
    "backendError.status.403": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to do that."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有权限执行此操作。"
          }
        }
      }
    },
    "backendError.status.404": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That item was not found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到对应内容。"
          }
        }
      }
    },
    "backendError.status.405": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request was refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求被拒绝。"
          }
        }
      }
    },
    "backendError.status.408": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is still unknown. Please try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚未确定，请稍后再试。"
          }
        }
      }
    },
    "backendError.status.409": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item changed. Refresh and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容已变化，请刷新后再试。"
          }
        }
      }
    },
    "backendError.status.410": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That item is no longer available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该内容已不可用。"
          }
        }
      }
    },
    "backendError.status.413": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request is too large."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求过大。"
          }
        }
      }
    },
    "backendError.status.415": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request isn't in a supported format."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求格式不受支持。"
          }
        }
      }
    },
    "backendError.status.422": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request was not accepted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求未被接受。"
          }
        }
      }
    },
    "backendError.status.426": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app version is no longer supported. Update the app before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前应用版本已不受支持，请更新应用后再继续。"
          }
        }
      }
    },
    "backendError.status.429": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Please wait and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作过于频繁，请稍后再试。"
          }
        }
      }
    },
    "backendError.status.500": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service couldn't complete that. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务未能完成此操作，请重试。"
          }
        }
      }
    },
    "backendError.status.503": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service is unavailable right now. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务暂不可用，请重试。"
          }
        }
      }
    },
    "backendError.status.520": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original result is still unknown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原命令结果仍未知。"
          }
        }
      }
    },
    "backendError.status.501": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That action isn't implemented yet. Try a different action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此接口尚未实现，请改用其他操作。"
          }
        }
      }
    },
    "backendError.status.601": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service sent a warning. Read it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回了警告，请查看后再试。"
          }
        }
      }
    },
    "backendError.code.ADVANCED_FIRST": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish this stop's task before arriving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成这一站的任务，再记录到达。"
          }
        }
      }
    },
    "backendError.code.ANSWER_WRONG": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That answer wasn't accepted. Submit a new answer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "答案不正确，请提交新的答案。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_ACCURACY_INVALID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locate again. This is not a cheating verdict."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新定位。这不是作弊判定。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_ACCURACY_LOW": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move into the open and locate again. A weak signal does not widen the stop's area."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请到开阔处重新定位。信号差不会放宽这一站的范围。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_ACCURACY_MISSING": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locate again so the reading includes its accuracy. This is not a cheating verdict."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新定位，让读数带上精度。这不是作弊判定。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_COORD_NOT_CONFIGURED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trying again will not help. The organizer needs to fix this stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试不会成功，需要组织者修正这一站。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_FIRST": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your arrival at this stop before answering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先记录到达这一站，再作答。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_GUARD_SPEED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending again would be refused the same way. Check this on the stop again on site."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次发送也会被同样拒绝，请在现场重新核验。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_GUARD_THROTTLE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait a moment, then locate again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍等片刻再重新定位。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_GUARD_WINDOW_DISTANCE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending again would be refused the same way. Check this on the stop again on site."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次发送也会被同样拒绝，请在现场重新核验。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_LOCATION_INVALID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locate again and send the new reading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新定位后再提交新的读数。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_LOCATION_MISSING": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow location for Chein, then locate again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请允许城瘾使用定位，然后重新定位。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_LOCATION_STALE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locate again to send a fresh reading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新定位，提交新的读数。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_NOT_RECORDED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your arrival here before answering."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先记录到达这一站，再作答。"
          }
        }
      }
    },
    "backendError.code.ARRIVE_TOO_FAR": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk closer to the stop, then locate again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请走近这一站后重新定位。"
          }
        }
      }
    },
    "backendError.code.BOARD_CURSOR_STALE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This list changed. Refresh and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列表已变化，请刷新后再试。"
          }
        }
      }
    },
    "backendError.code.CASH_CLOSED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cash case did not complete a payment. Cash payout is closed. Choose a non-cash reason."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次现金处理没有完成支付。现金发放已关闭，请改用非现金原因。"
          }
        }
      }
    },
    "backendError.code.CHAPTER_REDEEMED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chapter is already redeemed. Continue to the next stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本章已核销，请前往下一站。"
          }
        }
      }
    },
    "backendError.code.CITY_MAP_CURSOR_STALE": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The map changed. Refresh and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图已变化，请刷新后再试。"
          }
        }
      }
    },
    "backendError.code.CITY_ORDERED_RESET_REQUIRED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The map needs to be reloaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图需要重新加载。"
          }
        }
      }
    },
    "backendError.code.CITY_QUERY_TOO_BROAD": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That map area is too large. Zoom in and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图范围太大，请放大后再试。"
          }
        }
      }
    },
    "backendError.code.CITY_SNAPSHOT_CHANGED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The map changed. Refresh and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图已变化，请刷新后再试。"
          }
        }
      }
    },
    "backendError.code.CONFIG_INVALID": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stop isn't set up. Ask the organizer to fix it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一站尚未配置，请联系组织者修正。"
          }
        }
      }
    },
    "backendError.code.DIRECTORY_CHANGED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The friend list changed. Refresh and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好友列表已变化，请刷新后再试。"
          }
        }
      }
    },
    "backendError.code.DIRECTORY_GROUP_NOT_FOUND": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That friend group was not found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到该好友分组。"
          }
        }
      }
    },
    "backendError.code.EVENT_UNKNOWN": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That event isn't supported. Choose a listed event and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事件不合法，请选择已列出的事件后再试。"
          }
        }
      }
    },
    "backendError.code.FEATURE_CLOSED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This did not complete a payment. Cash and payout stay closed on this host. Use a non-cash reward, or try again only where payments are open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次没有完成支付。本主机的现金与发放保持关闭。请改用非现金奖励，或仅在支付开放时再试。"
          }
        }
      }
    },
    "backendError.code.FORBIDDEN": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to do that."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有权限执行此操作。"
          }
        }
      }
    },
    "backendError.code.FRIEND_INVITE_REJECTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This friend invite was declined."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条好友邀请已被拒绝。"
          }
        }
      }
    },
    "backendError.code.FRIEND_NOT_FOUND": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That friend was not found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到该好友。"
          }
        }
      }
    },
    "backendError.code.GAME_AUTHORITY_CONFLICT": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play authority changed. Confirm again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "执行权已变化，请重新确认。"
          }
        }
      }
    },
    "backendError.code.GUILD_FORBIDDEN": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join this club before managing it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入后才能操作。"
          }
        }
      }
    },
    "backendError.code.H5_REJECTED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That page was rejected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该页面已被拒绝。"
          }
        }
      }
    },
    "backendError.code.H5_TIMEOUT": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That page timed out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该页面已超时。"
          }
        }
      }
    },
    "backendError.code.HANGOUT_CLOSED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation is closed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话已关闭。"
          }
        }
      }
    },
    "backendError.code.IM_CONVERSATION_CLOSED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation is closed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话已关闭。"
          }
        }
      }
    },
    "backendError.code.INTENT_ACTION_REUSED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action was already used for different input. Start a new attempt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次操作已用于另一份输入，请重新开始一次。"
          }
        }
      }
    },
    "backendError.code.INTENT_INPUT_INVALID": {
      "localizations": {
        "en": {
          "stringUnit": {
