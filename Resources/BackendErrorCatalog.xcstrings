      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Please wait and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作过于频繁，请稍后再试。"
          }
        }
      }
    },
    "backendError.status.500": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service couldn't complete that. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务未能完成此操作，请重试。"
