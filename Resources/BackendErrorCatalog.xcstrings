{
  "sourceLanguage": "en",
  "strings": {
    "backendError.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题，请重试。"
          }
        }
      }
    },
    "backendError.status.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Please sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已过期，请重新登录。"
          }
        }
      }
    },
    "backendError.status.400": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request was not accepted. Check it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求未被接受，请检查后再试。"
          }
        }
      }
    },
    "backendError.status.401": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Please sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已过期，请重新登录。"
          }
        }
      }
    },
    "backendError.status.403": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to do that."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有权限执行此操作。"
          }
        }
      }
    },
    "backendError.status.404": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That item was not found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到对应内容。"
          }
        }
      }
    },
    "backendError.status.405": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request was refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求被拒绝。"
          }
        }
      }
    },
    "backendError.status.408": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result is still unknown. Please try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果尚未确定，请稍后再试。"
          }
        }
      }
    },
    "backendError.status.409": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item changed. Refresh and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容已变化，请刷新后再试。"
          }
        }
      }
    },
    "backendError.status.410": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That item is no longer available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该内容已不可用。"
          }
        }
      }
    },
    "backendError.status.413": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request is too large."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求过大。"
          }
        }
      }
    },
    "backendError.status.415": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request isn't in a supported format."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求格式不受支持。"
          }
        }
      }
    },
    "backendError.status.422": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That request was not accepted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求未被接受。"
          }
        }
      }
    },
    "backendError.status.426": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app version is no longer supported. Update the app before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前应用版本已不受支持，请更新应用后再继续。"
