    "r3club.consequence.ban.confirm": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "封禁"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ban"
          }
        }
      }
    },
    "r3club.consequence.ban.line1": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "封禁期间 TA 不能报名俱乐部活动、发帖或评论。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While banned they can't sign up for club events, post or comment."
          }
        }
      }
    },
    "r3club.consequence.ban.line2": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TA 会收到一条封禁通知，期满后自动解除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They get a ban notice; the ban lifts by itself when it ends."
          }
        }
      }
    },
    "r3club.consequence.ban.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "封禁这位成员？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ban this member?"
          }
        }
      }
    },
    "r3club.consequence.dissolve.confirm": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解散俱乐部"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissolve club"
          }
        }
      }
    },
    "r3club.consequence.dissolve.line1": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部成员会被移出俱乐部，同时失去群聊入口"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every member is removed from the club and loses the group chat."
          }
        }
      }
    },
    "r3club.consequence.dissolve.line2": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "俱乐部名下的活动与会员权益一并下架；已报名的不会自动取消，也不会自动退款"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The club’s events and member perks are taken down. Existing sign-ups aren’t cancelled or refunded automatically."
          }
        }
      }
    },
    "r3club.consequence.dissolve.line3": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作不可撤销，解散后无法恢复这个俱乐部"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can’t be undone. A dissolved club can’t be restored."
          }
        }
      }
    },
    "r3club.consequence.dissolve.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解散这个俱乐部？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissolve this club?"
          }
        }
      }
    },
    "r3club.consequence.endTopic.confirm": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束并退款"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End and refund"
          }
        }
      }
    },
    "r3club.consequence.endTopic.line1": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止售卖并把未核销的票原价退回"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops sales and refunds every unredeemed ticket in full"
          }
        }
      }
    },
    "r3club.consequence.endTopic.line2": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只是想让它不再露出的话，下架就够了"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you only want to hide it, taking it offline is enough"
          }
        }
      }
    },
    "r3club.consequence.endTopic.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束主题"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End topic"
          }
        }
      }
    },
    "r3club.consequence.revokeRole.confirm": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销身份"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove role"
          }
        }
      }
    },
    "r3club.consequence.revokeRole.line1": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TA 会失去这个身份带来的管理权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They lose the permissions that come with this role."
          }
        }
      }
    },
    "r3club.consequence.revokeRole.line2": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TA 仍是俱乐部成员，之后可以重新设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They stay in the club; you can assign the role again later."
          }
        }
      }
    },
    "r3club.consequence.revokeRole.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销 TA 的身份？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove their role?"
          }
        }
      }
    },
    "r3club.consequence.transferOwner.confirm": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转让"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer"
          }
        }
      }
    },
    "r3club.consequence.transferOwner.line1": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方成为主理人，你会变成普通成员。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They become the organiser and you become a member."
          }
        }
      }
    },
    "r3club.consequence.transferOwner.line2": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转让后你不能再改设置、管理成员或撤回这次转让。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the transfer you can't change settings, manage members or undo it."
          }
        }
      }
    },
    "r3club.consequence.transferOwner.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转让这个俱乐部？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer this club?"
          }
        }
      }
    },
    "r3club.invite.hint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用分享发一段邀请文字"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share an invitation message"
          }
        }
      }
    },
    "r3club.invite.message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来城瘾加入「%1$@」俱乐部吧：打开城瘾，在俱乐部里搜索「%1$@」就能找到我们。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join “%1$@” on Chein: open the app and search for “%1$@” in Clubs."
          }
        }
      }
    },
    "r3club.invite.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请成员"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite members"
          }
        }
      }
    },
